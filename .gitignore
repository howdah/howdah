/target
**/target
# Cargo.lock IS committed: clean-checkout container builds (lab/integration/matrix.sh)
# need a pinned dependency set to build the extension reproducibly per PHP minor.
*.so
*.o
*.rlib
*.swp
.DS_Store
# Lab/build artifacts
/lab/**/vendor
/lab/integration/.matrix-out
/lab/integration/.refusal-out
/lab/integration/.oom-backstop-out
/lab/integration/.recycle-out
/lab/integration/.request-limits-out
/lab/integration/.log-consumers-out
# Benchmark runs (lab/bench/run.sh, corpus.sh, jit.sh); published runs are
# copied into lab/bench/results/ by hand.
/lab/bench/out
/packaging/out
# cargo-fuzz crash inputs and corpora
/fuzz/artifacts
/fuzz/corpus
# Site build
/site/dist
/site/node_modules
/site/.test-build.lock
# Built from the checkout by `npm run wasm` / pages.yml; never committed
/site/demo/howdah_wasm.wasm
# Local-only: shaped-request generator and reproducers stay out of the public repo
# until a release that blocks them is installable (design §9).
/lab/spike/measure.sh
/lab/spike/*gen*
/private/
/.gnupg-home
/.superpowers/
# Playwright MCP screenshots/snapshots from browser checks
/.playwright-mcp
