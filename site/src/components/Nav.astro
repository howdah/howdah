---
// Site header: brand + primary nav. `path` is the current page path so the
// active link gets aria-current. The GitHub link is appended after the model.
import { NAV, REPO, isActive } from '../lib/site';

interface Props {
  path: string;
}
const { path } = Astro.props;
---
<div class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Howdah, home">
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M6 41h36" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none"/>
        <path d="M10 41V27h28v14" fill="var(--hot-bg)" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
        <path d="M8 27c0-9 7-17 16-17s16 8 16 17z" fill="var(--accent)" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
        <path d="M24 10V5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <path d="M18 34h12" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      </svg>
      Howdah
    </a>
    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href, path) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li><a href={REPO}>GitHub</a></li>
      </ul>
    </nav>
  </div>
</div>
