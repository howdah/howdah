---
// The site-wide status banner. Steers first-timers to detect mode and the
// coverage table before they switch anything to block. Version comes from site.ts.
import { RELEASES, VERSION } from '../lib/site';
---
<div class="status" role="note" aria-label="Project status">
  <div class="wrap">
    <strong>Released</strong>
    <p><a href={`${RELEASES}/tag/v${VERSION}`}>Howdah {VERSION} is released</a> — Layer 1 (request-shape limits), Layer 2 (input inspection, log-only), Layer 3 (sink hardening, log-only) and Layer 4 (after-breach behaviour, log-first). Howdah starts in <code>detect</code> mode: the critical limits block, everything else only logs. Read the <a href="/coverage/">coverage table</a> for exactly what has been tested on your PHP version before you switch rules to block.</p>
  </div>
</div>
