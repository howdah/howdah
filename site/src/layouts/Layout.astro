---
// The shared page shell: <head>, skip-link, status banner, header/nav, <main>,
// footer. Every page renders inside it. `lang`/`dir` are threaded so a future
// locale drops in without restructuring (design §10 "i18n routing … RTL-ready").
import '../styles/global.css';
import StatusBanner from '../components/StatusBanner.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
}
const { title, description, path, lang = 'en', dir = 'ltr' } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://howdah.org/').href;
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#14112a" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f7f1e5" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <StatusBanner />
    <Nav path={path} />
  </header>
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
