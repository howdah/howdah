  #cfg fieldset { border: 1px solid var(--rule); background: var(--surface); border-radius: 10px; margin: 0 0 1.25rem; padding: .75rem 1.1rem 1rem; min-width: 0; }
  #cfg legend { font-weight: 600; font-family: var(--display); padding: 0 .4rem; font-size: 1.15rem; }
  #cfg .small, .small { font-size: .9rem; color: var(--muted); margin: .25rem 0 .75rem; }
  .group h3 { font-size: 1rem; font-family: var(--sans); margin: 1rem 0 .25rem; }
  .ctl { padding: .55rem 0; border-top: 1px solid var(--rule); }
  .ctl:first-of-type { border-top: 0; }
  .ctl label { display: block; margin-bottom: .3rem; }
  .ctl input[type=number], .ctl input[type=text], .ctl select, .ctl textarea { width: 100%; max-width: 28rem; min-height: 44px; font-size: 1rem; font-family: var(--mono); padding: .4rem .6rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .ctl textarea { min-height: 5rem; }
  .ctl input[type=checkbox] { width: 1.5rem; height: 1.5rem; }
  .ctl small { display: block; color: var(--muted); font-size: .85rem; margin-top: .3rem; max-width: 60ch; }
  .def { color: var(--muted); font-size: .85rem; margin-left: .4rem; }
  .rules { display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  table.exc { width: 100%; border-collapse: collapse; font-size: .9rem; }
  table.exc th, table.exc td { padding: .3rem .35rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  table.exc input { width: 11rem; min-width: 7rem; font: inherit; font-size: .85rem; }
  table.exc input[data-exc="reason"] { width: 24rem; }
  table.exc input[data-exc="client_cidr"], table.exc input[data-exc="param_prefix"] { width: 8rem; }
  table.exc .req { color: var(--accent, #b00); }
  table.exc .exc-empty td { white-space: normal; }
  .small-btn { padding: .2rem .5rem; font-size: .8rem; }
  .noop { margin-top: 1rem; border-top: 1px solid var(--rule); padding-top: .5rem; }
  .noop summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .rule select { max-width: 12rem; }
  .tag { display: inline-block; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; padding: .1rem .45rem; border-radius: 999px; margin-left: .4rem; vertical-align: middle; border: 1px solid var(--rule); }
  .tag.critical { background: var(--no-bg); color: var(--no); border-color: transparent; }
  .tag.standard { background: var(--ok-bg); color: var(--ok); border-color: transparent; }
  .tag.php { background: var(--hot-bg); color: var(--hot); border-color: transparent; }
  #out { background: var(--surface); border: 2px solid var(--rule); border-radius: 10px; padding: 1rem 1.2rem 1.2rem; min-width: 0; }
  #out h2 { margin-top: 0; font-size: 1.3rem; }
  #out h3 { font-size: 1.05rem; margin: 1.25rem 0 .4rem; }
  #out pre { margin: 0; max-height: 24rem; overflow: auto; white-space: pre; }
  .valid { font-weight: 600; padding: .5rem .7rem; border-radius: 6px; border-left: 4px solid var(--rule); background: var(--bg); }
  .valid.ok { border-left-color: var(--ok); }
  .valid.bad { border-left-color: var(--no); font-family: var(--mono); font-weight: 500; font-size: .9rem; white-space: pre-wrap; }
  .valid.pending { border-left-color: var(--hot); }
  .tabs { display: flex; gap: .25rem; margin: .75rem 0 .25rem; border-bottom: 1px solid var(--rule); }
  .tabs [role=tab] { background: none; border: 0; border-bottom: 3px solid transparent; padding: .5rem .8rem; min-height: 44px; font: inherit; color: var(--muted); cursor: pointer; }
  .tabs [role=tab][aria-selected=true] { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }
  .tabs [role=tab]:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
  .opt { display: block; margin: .8rem 0 0; }
  .opt input { width: 1.5rem; height: 1.5rem; margin-right: .4rem; vertical-align: middle; }
  #curl-pre.disabled { opacity: .6; }
  .btn[disabled] { opacity: .5; cursor: not-allowed; text-decoration: none; }
  .legend-list { max-width: 60ch; }
  .legend-list li { margin: .4rem 0; }
</style>
