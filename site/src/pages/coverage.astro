---
import Layout from '../layouts/Layout.astro';
import coverage from '../data/coverage.json';
import { REPO } from '../lib/site';

const rows = coverage.rows;
const ranDate = (coverage.generated || '').slice(0, 10);
// Runs outside the matrix, as cards: passed first, then the failures that
// explain why a runtime is not supported.
const runsPassed = coverage.runtimes.filter((r: any) => r.result === 'PASS');
const runsFailed = coverage.runtimes.filter((r: any) => r.result !== 'PASS');
const runGroups = [
  { id: 'runtimes-passed', title: 'Passed: Howdah loaded and refused the over-limit request', runs: runsPassed },
  { id: 'runtimes-failed', title: 'Failed: why these runtimes are not supported', runs: runsFailed },
].filter((g) => g.runs.length);
const oneNotRun = coverage.notRunMinors.length === 1;
const SAPIS = ['cli', 'fpm', 'apache'] as const;
const SAPI_LABEL: Record<string, string> = { cli: 'CLI server', fpm: 'php-fpm', apache: 'Apache mod_php' };

// Map a per-SAPI cell to a display {pill class, label}. State comes straight
// from the generated data; nothing here invents a verdict.
function cell(sapi: any) {
  if (!sapi || sapi.state === 'none') return { cls: 'na', label: 'not tested' };
  if (sapi.state === 'pass') return { cls: 'ok', label: 'blocked' };
  if (sapi.state === 'skip') return { cls: 'na', label: 'skipped' };
  if (sapi.state === 'fail') return { cls: 'no', label: 'FAILED' };
  return { cls: 'na', label: sapi.state };
}
---
<Layout
  title="Coverage — what Howdah has actually been tested against"
  description="The Howdah test matrix: for every PHP version and server type, whether an upload/part flood was blocked, skipped, or not run. Generated from the lab results, never hand-typed."
  path="/coverage/"
>
  <div class="pagehead">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / <span aria-current="page">Coverage</span></p>
      <h1>Coverage: what has actually been tested</h1>
      <p class="lede">Every cell on this page is generated from the lab test matrix{ranDate && <> (run {ranDate}{coverage.matrixVersion && <> on Howdah {coverage.matrixVersion}</>})</>}, never typed by hand. A version is only called &ldquo;blocked&rdquo; where the test for that exact version and server type passed.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="totals" role="group" aria-label="Test totals">
        <div><strong>{coverage.totals.pass}</strong><span>checks passed</span></div>
        <div><strong>{coverage.totals.fail}</strong><span>failed</span></div>
        <div><strong>{coverage.totals.skip}</strong><span>skipped</span></div>
        <div><strong>{coverage.corpusFalsePositives}</strong><span>false positives in the legitimate-upload corpus</span></div>
      </div>

      <h2>By PHP version and server type</h2>
      <p>The two flood shapes tested are a <strong>file-part flood</strong> (<code>max_files</code>) and a <strong>field/part flood</strong> (<code>max_parts</code>). &ldquo;Blocked&rdquo; means the shaped request got HTTP 403 and a log entry at the default limits, on a server with raised caps (the exposed setup). The same runs also sent seven ordinary uploads; none was blocked.</p>
      {coverage.matrixVersion && <p class="legend"><strong>Which release this is.</strong> The matrix ran on Howdah {coverage.matrixVersion}. Later releases changed the multipart glue (1.2.1) and the refusal path (1.5.0) and were checked by narrower runs: on every pull request, CI runs the block-shaped and self-test scripts on PHP 5.6, 7.3 and 8.4 (tags and a weekly run add 5.4, 7.4 and 8.1), the 1.5.0 Docker images passed a smoke test on all twelve Debian bases (<a href="#runtimes">below</a>), and the refusal lab checks php-fpm behind nginx and Apache on 5.6, 7.4 and 8.3. A re-run of this matrix on the current release is pending.</p>}
      <div class="tablewrap" tabindex="0" role="region" aria-label="Coverage by PHP version and server type (scrolls sideways on narrow screens)">
        <table>
          <caption class="sr-only">Per-version, per-server-type coverage</caption>
          <thead>
            <tr>
              <th scope="col">PHP</th>
              {SAPIS.map((s) => <th scope="col">{SAPI_LABEL[s]}</th>)}
              <th scope="col">Notes</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r: any) => (
              <tr>
                <th scope="row">{r.version ?? r.minor}</th>
                {r.version ? (
                  <>
                    {SAPIS.map((s) => {
                      const c = cell(r.sapis?.[s]);
                      return <td><span class={`pill ${c.cls}`}>{c.label}</span></td>;
                    })}
                    <td><small style="margin:0">{SAPIS.map((s) => r.sapis?.[s]?.note).filter(Boolean).join('; ')}</small></td>
                  </>
                ) : (
                  <>
                    <td colspan="3"><span class="pill na">not run</span></td>
                    <td><small style="margin:0">{r.why}</small></td>
                  </>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="legend">Totals: {coverage.totals.pass} passed, {coverage.totals.fail} failed, {coverage.totals.skip} skipped. Generated by <a href={`${REPO}/blob/main/site/scripts/gen-coverage.mjs`}>a script</a> from <a href={`${REPO}/blob/main/lab/integration/matrix-results.tsv`}>the raw matrix results</a>. The same data in prose is in <a href={`${REPO}/blob/main/docs/coverage.md`}>docs/coverage.md</a>.</p>

      <h2 id="runtimes">Other server types and runtimes</h2>
      <p>These runs are not part of the table above. Each card is one run of one script, recorded in <a href={`${REPO}/blob/main/${coverage.runtimeSource}`}>the runtime results</a>: a self-test (a marker request, a request one part over the limit, a normal form), not the full matrix.</p>
      {runGroups.map((g) => (
        <>
          <h3 id={g.id} class="runs-title">{g.title} <span class="runs-count">({g.runs.length})</span></h3>
          <ul class="runs">
            {g.runs.map((r: any) => {
              const ok = r.result === 'PASS';
              return (
                <li class={`run ${ok ? 'run-ok' : 'run-no'}`}>
                  <div class="run-head">
                    <span class={`pill ${ok ? 'ok' : 'no'}`}>{ok ? 'passed' : 'failed'}</span>
                    <h4>{r.runtime}</h4>
                  </div>
                  <dl class="run-meta">
                    <div><dt>CPU</dt><dd>{r.arch}</dd></div>
                    <div><dt>PHP</dt><dd>{r.php.join(', ')}</dd></div>
                    <div><dt>Script</dt><dd><code>{r.script}</code></dd></div>
                    <div><dt>Date</dt><dd>{r.date}</dd></div>
                  </dl>
                  <p class="run-detail">{r.detail}</p>
                </li>
              );
            })}
          </ul>
        </>
      ))}

      <h2 id="limits">Honest limits</h2>
      <p>What this page does not show, and what Howdah cannot do. Each card leads with the point; open &ldquo;Details&rdquo; for the specifics.</p>

      <h3 class="lim-group">What the matrix above covers</h3>
      <ul class="limits">
        <li><strong>Apache and php-fpm: PHP 5.6 to 8.5.</strong> <p>Both were tested on every minor whose row shows a result: 5.6 and 7.0 to 8.5.</p></li>
        <li><strong>PHP 5.4: the CLI server only.</strong> <p>Its stock image has no <code>cgi-fcgi</code>, so php-fpm was skipped, and there is no <code>php:5.4-apache</code> image.</p></li>
        <li><strong>Not run: PHP {coverage.notRunMinors.join(', ')}.</strong> <p>{oneNotRun ? 'It shares' : 'They share'} a code path with a version that passed. That is a reason to expect {oneNotRun ? 'it works' : 'they work'}, not a test result, and {oneNotRun ? 'it is' : 'they are'} <strong>not</strong> claimed as passing.</p></li>
        <li><strong>Linux x86_64 only.</strong> <p>aarch64 is build-verified for all 14 minors (PHP 5.4 since the 1.3.0 build fix). On arm64 only the self-test and block-shaped scripts have run (<a href="#runtimes">other runtimes</a>), not the matrix.</p></li>
        <li><strong>CVE-2026-109618's upload-progress path was not reproduced.</strong> <p>The tests recreate only the shape of a flood, not the CVE's <code>session.upload_progress</code> header-parsing path, so Howdah is not claimed to block that CVE on a stock configuration. Upload progress on and off were both tested, to confirm Howdah works either way.</p></li>
        <li><strong>Request-header limits can act after the script.</strong> <p>The multipart and input-shape limits refuse before the script runs. The header count and size limits act at request shutdown when the script builds <code>$_SERVER</code> lazily and Layer 2 is not armed; there the log line is the signal. See <a href="/docs/configuration/#enforcement-timing">enforcement timing</a>.</p></li>
      </ul>

      <h3 class="lim-group">What Howdah cannot protect</h3>
      <ul class="limits limits-no">
        <li><strong>CVE-2012-1823 (php-cgi argument injection).</strong> <p>php-cgi consumes that query during its own startup, before any PHP extension loads. CVE-2019-11043 is the same case. Use a web-server or front-proxy rule.</p></li>
        <li><strong>Threaded PHP (ZTS).</strong> <p>Howdah is built for NTS PHP only, so FrankenPHP and Apache's threaded MPMs with <code>mod_php</code> are not supported. A test build failed under concurrent requests (<a href={`${REPO}/blob/main/docs/zts.md`}>docs/zts.md</a>).</p></li>
        <li><strong>Anything that never runs through PHP.</strong> <p>Layer 4 sees only PHP. A process PHP launches and then detaches, a reverse shell that forks away, or a dropper that never ran through PHP is invisible to it.</p></li>
      </ul>

      <h3 class="lim-group">Tested elsewhere, not in this table</h3>
      <ul class="limits">
        <li><strong>Layer 2, input inspection (1.1).</strong> <p>Detects SQL injection, path-traversal and command-injection patterns in request values. It is best-effort and can be bypassed, which is why it logs and does not block by default.</p></li>
        <li><strong>Layer 3, sink hardening (1.2 to 1.5).</strong> <p>Its per-version table is on the <a href="/#sinks">home page</a>. It logs by default, blocks only when armed, and is best-effort and bypassable.</p>
          <details><summary>Details</summary><p>It guards command execution, <code>unserialize</code>, <code>include</code>/<code>require</code> and <code>eval</code> (the last two on PHP 5.x too since 1.3), plus <code>phar://</code> and SSRF (1.3, both off by default). 1.5 added seven legacy sinks (<code>mail_injection</code>, <code>preg_eval</code>, <code>create_function</code>, <code>assert_string</code>, <code>dangerous_callback</code>, <code>xxe</code>, <code>tls_verify</code>; all log-first) and the JIT-safe <code>[sinks] hook</code>. The 1.3 mechanisms were verified on PHP 5.4, 5.6, 7.4, 8.3 and 8.5; other minors build and are expected to work but are not independently verified. A debug-build leak review is pending.</p></details></li>
        <li><strong>Layer 4, after a breach (1.4).</strong> <p>Its lab script (27 checks) passed on PHP 5.4, 5.6, 7.4, 8.3, 8.4 and 8.5; other minors are not independently verified. Every list ships empty, and it blocks only with <code>behavior.mode = "block"</code>.</p>
          <details><summary>Details</summary><p>It watches PHP run from denied directories, exec-family calls to unlisted programs, outbound connections to unlisted hosts, and PHP files written into denied directories.</p></details></li>
        <li><strong>Performance.</strong> <p>Latency with and without Howdah, the OPcache JIT result and what Layer 2 flags of the GoTestWAF corpus are on the <a href="/docs/performance/">performance page</a>. They were measured before the 1.5 changes (latency on Howdah 1.4.0, the JIT and corpus runs on 1.3.0); a re-measure is pending.</p></li>
      </ul>

      <h3 class="lim-group">Best-effort mechanisms</h3>
      <ul class="limits">
        <li><strong>phar:// (1.3).</strong> <p>On PHP 5.x and 7.x it covers phar metadata deserialization through the stream wrapper. On PHP 8.x it detects and denies <code>phar://</code> use only, with no deserialization claim.</p>
          <details><summary>Details</summary><p>The direct Phar API (<code>new Phar</code>, <code>PharData</code>, <code>Phar::loadPhar</code>, <code>Phar::mapPhar</code>, <code>Phar::getMetadata</code>) is not covered. Another extension re-registering <code>phar</code>, or a static phar build, fails open.</p></details></li>
        <li><strong>SSRF (1.3).</strong> <p>Detection resolves the host when the call is checked. It is not a connection-time boundary.</p>
          <details><summary>Details</summary><p>It is bypassed by DNS rebinding, redirects, <code>curl_multi_*</code>, <code>CURLOPT_RESOLVE</code>/<code>CONNECT_TO</code> and a non-string or absent <code>CURLOPT_URL</code>. Not hooked: <code>copy</code>, <code>file</code>, <code>readfile</code>, <code>SoapClient</code>, <code>DOMDocument::load*</code>, <code>simplexml_load_file</code>. It adds a <code>getaddrinfo</code> per distinct outbound host with no timeout; more than 32 resolved addresses are capped, and a host over 256 bytes is treated as suspicious.</p></details></li>
        <li><strong><code>include</code> on PHP 5.x (1.3).</strong> <p>Checked at compile time, so a file served from a warm opcache is not re-inspected. <code>eval</code> is unaffected, and so is the PHP 7.0+ opcode handler.</p></li>
        <li><strong>Layer 4 <code>deny_exec_dirs</code>.</strong> <p>The requested-script check does not depend on opcache. The <code>require</code>d-file check runs at first compile and is best-effort, so a file served from a warm opcache may not be re-checked.</p>
          <details><summary>Details</summary><p>On PHP 7.0+ the <code>require</code>d-file check sees the operand string only. A relative-path <code>require</code> is not checked at include time on any version.</p></details></li>
        <li><strong>Layer 4 allowlists and writes.</strong> <p><code>allow_exec_binaries</code> and <code>allow_egress_hosts</code> are best-effort and can be bypassed. <code>observe</code> only proposes.</p>
          <details><summary>Details</summary><p>Egress matching shares the SSRF limits above. <code>deny_php_writes</code> is scoped by origin and matches by file extension, and it can still flag frameworks that compile templates into a denied directory. On an already-breached box, <code>observe</code>'s output may include attacker behaviour.</p></details></li>
        <li><strong>OPcache JIT.</strong> <p>A default install keeps the JIT on. With the default hook, setting <code>[sinks.include] allow_paths</code> or <code>[behavior] deny_exec_dirs</code> installs an opcode handler, and PHP then turns the JIT off; <code>[sinks] hook = "compile"</code> keeps it on.</p>
          <details><summary>Details</summary><p>PHP turns its JIT off whenever an extension installs a user opcode handler, and one of Howdah's two <code>include</code>/<code>eval</code> mechanisms on PHP 7.0+ is one. Nothing is installed unless the <code>eval</code> sink is on, the <code>include</code> sink has <code>allow_paths</code>, or <code>deny_exec_dirs</code> is set. The default <code>hook = "auto"</code> uses the compile pointer when only <code>eval</code> needs the hook (the shipped default), and the opcode handler when <code>include</code> has <code>allow_paths</code> or <code>deny_exec_dirs</code> is set, where an include served from a warm opcache matters; it then writes one startup line. <code>hook = "compile"</code> keeps the JIT on even then, at the cost that a warm-opcache <code>include</code> is not re-inspected (<code>eval</code> is still fully covered). Verified with <code>opcache_get_status()</code> on PHP 8.1 and 8.3 (<code>lab/integration/jit.sh</code>); <code>php --ri howdah</code> shows which mechanism is in use and why.</p></details></li>
      </ul>

      <h3 class="lim-group">Older releases</h3>
      <ul class="limits">
        <li><strong>Up to 1.4.0, a refusal ended the php-fpm worker.</strong> <p>The worker exited with code 70, and the 403 often reached the client without Howdah's message. From 1.5.0 the 403/413 is delivered cleanly and the worker survives. The event is logged either way (<a href={`${REPO}/blob/main/docs/install-docker.md`}>docs/install-docker.md</a>).</p></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .totals { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); margin: 0 0 2rem; }
  @media (min-width: 40rem) { .totals { grid-template-columns: repeat(4, 1fr); } }
  .totals > div { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 1rem 1.1rem; }
  .totals strong { display: block; font: 700 2rem/1 var(--display); color: var(--hot); }
  .totals span { font-size: .85rem; color: var(--muted); }

  /* Runs outside the matrix: one card per run, no sideways scrolling. */
  .runs-title { margin: 1.75rem 0 .75rem; font-size: 1.05rem; font-family: var(--sans); font-weight: 600; letter-spacing: 0; }
  .runs-count { color: var(--muted); font-weight: 500; }
  .runs, .limits { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .run { background: var(--surface); border: 1px solid var(--rule); border-left: 4px solid var(--ok); border-radius: 10px; padding: 1rem 1.1rem; min-width: 0; }
  .run-no { border-left-color: var(--no); }
  .run-head { display: flex; gap: .6rem; align-items: baseline; }
  .run-head .pill { flex: none; }
  .run-head h4 { margin: 0; font: 600 1rem/1.35 var(--sans); letter-spacing: 0; overflow-wrap: anywhere; }
  .run-meta { display: grid; grid-template-columns: max-content 1fr; gap: .25rem .75rem; margin: .8rem 0 0; font-size: .88rem; }
  .run-meta > div { display: contents; }
  .run-meta dt { color: var(--muted); }
  .run-meta dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .run-meta code { font-size: .82rem; }
  .run-detail { margin: .75rem 0 0; font-size: .88rem; color: var(--muted); overflow-wrap: anywhere; }

  /* Honest limits: grouped cards, the point in bold, specifics behind Details. */
  #limits { margin-top: 3rem; }
  .lim-group { margin: 2rem 0 .75rem; font-size: 1.05rem; font-family: var(--sans); font-weight: 600; letter-spacing: 0; }
  .limits > li { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 1rem 1.1rem; min-width: 0; }
  .limits-no > li { border-left: 4px solid var(--no); }
  .limits > li > strong { display: block; line-height: 1.35; }
  .limits p { margin: .4rem 0 0; font-size: .92rem; overflow-wrap: anywhere; }
  .limits details { margin-top: .6rem; font-size: .9rem; }
  .limits summary { cursor: pointer; color: var(--accent); font-weight: 600; }
  .limits details p { color: var(--muted); }
</style>
