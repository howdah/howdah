              <th scope="col">Tool</th>
              <th scope="col">Where it runs</th>
              <th scope="col">License</th>
              <th scope="col">Main job</th>
              <th scope="col">Runs on EOL PHP (5.4&ndash;8.1)?</th>
              <th scope="col">External service</th>
