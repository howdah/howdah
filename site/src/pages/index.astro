---
import Layout from '../layouts/Layout.astro';
import FitTable from '../components/FitTable.astro';
import coverage from '../data/coverage.json';
import { REPO, PKG, VERSION } from '../lib/site';

const rows = coverage.rows;
const ranDate = (coverage.generated || '').slice(0, 10);
// Display the major.minor (e.g. "1.2") so the install button tracks VERSION.
const shortVersion = VERSION.split('.').slice(0, 2).join('.');

// Four-layer model (design §3). Layer 1 shipped in 1.0, Layer 2 in 1.1,
// Layer 3 in 1.2, extended in 1.3, Layer 4 in 1.4 (all 'released', log-only).
// Non-active layers are dimmed so the page never implies they are in 1.0.
const layers = [
  { n: 1, name: 'Request parsing', covers: 'Upload/multipart floods (the PHP2Shell shape), input-variable floods and deeply nested arrays — refused while PHP parses the request. Too many or oversized headers are logged, and refused in block mode.', status: 'active' },
  { n: 2, name: 'Request inspection', covers: 'Content inspection of decoded GET/POST/cookie/path values for SQL injection, path traversal and command/code injection. It detects and logs; it does not block by default.', status: 'released' },
  { n: 3, name: 'Runtime checks', covers: 'Sink hardening: guards command execution, unserialize, include and eval with a flat allowlist policy, plus phar:// and an SSRF egress guard (both off by default, new in 1.3). It detects and logs; it does not block by default.', status: 'released' },
  { n: 4, name: 'After a breach', covers: 'Watches PHP run from upload directories, unexpected binaries, unexpected outbound hosts and .php writes. It detects and logs; it does not block by default, and does nothing until you set its lists.', status: 'released' },
];

// Comparison facts compiled Oct 2026 from each project's own documentation.
// Sources are cited as plain text (no external requests; see the methodology note).
const compareAsOf = 'October 2026';
const compare = [
  { name: 'Howdah', self: true, where: 'Inside PHP (Rust extension)', license: 'MIT OR Apache-2.0', job: 'Request-shape limits (Layer 1, blocks) + log-first input inspection, sink hardening & after-breach checks (Layers 2–4)', eol: 'Yes — 5.4 to 8.5, including EOL branches', ext: 'None' },
  { name: 'Snuffleupagus', where: 'Inside PHP (C extension)', license: 'LGPL', job: 'Hardening: kills bug classes + virtual-patching', eol: 'PHP 7.0+ (not 5.x)', ext: 'None' },
  { name: 'OpenRASP (Baidu)', where: 'Inside the app (RASP, hooks sinks)', license: 'Apache-2.0', job: 'Runtime detection of SQL/file/SSRF via sink hooks', eol: 'PHP extension; project quiet since 2022', ext: 'Self-hosted management' },
  { name: 'Aikido Zen', where: 'In-app agent (separate process)', license: 'Open-source agent + commercial cloud', job: 'Hooks runtime sinks (SQLi, SSRF, path/command injection)', eol: 'PHP 7.2+ (not 5.x)', ext: 'Aikido cloud (SaaS)' },
  { name: 'ModSecurity + OWASP CRS', where: 'Web-server module (Apache / Nginx)', license: 'Apache-2.0', job: 'Generic signature WAF at the server layer', eol: 'PHP-agnostic (sits in front of PHP)', ext: 'None' },
  { name: 'Datadog App & API Protection', where: 'In-app (tracing library) + SaaS', license: 'Proprietary (commercial)', job: 'In-app WAF / threat protection with managed rules', eol: 'Per the Datadog PHP library', ext: 'Datadog cloud (paid)' },
];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const compareRows = compare.map((c) => ({ head: esc(c.name), self: c.self, cells: [c.where, c.license, c.job, c.eol, c.ext].map(esc) }));

// The reference tables below render through FitTable, which never scrolls
// sideways (rows stack under a narrow container). Cells are HTML.
const multipartLimits = [
  { head: 'max_parts', cells: ['2000', 'Floods of form-field parts'] },
  { head: 'max_files', cells: ['200', 'File-part floods (the PHP2Shell shape)'] },
  { head: 'max_filename_bytes', cells: ['512', 'Oversized filenames'] },
  { head: 'max_field_name_bytes', cells: ['1024', 'Oversized field names'] },
  { head: 'max_parse_memory_bytes', cells: ['256&nbsp;MiB', 'Total body Howdah will process'] },
];
const inputLimits = [
  { head: 'max_input_vars', cells: ['2000', 'Variable / hash-collision floods'] },
  { head: 'max_input_nesting_depth', cells: ['64', 'Deeply nested arrays'] },
  { head: 'max_input_key_bytes', cells: ['1024', 'Oversized variable names / keys'] },
  { head: 'max_request_headers', cells: ['200', 'Request-header floods'] },
  { head: 'max_request_header_bytes', cells: ['16&nbsp;KiB', 'Oversized header lines'] },
];
const inspectClasses = [
  { head: 'SQL injection', cells: ['<code>sql_injection</code>', '<code>&#39; OR 1=1 --</code>'] },
  { head: 'Path traversal', cells: ['<code>path_traversal</code>', '<code>../../etc/passwd</code>'] },
  { head: 'Command / code injection', cells: ['<code>command_injection</code>', '<code>; cat /etc/passwd</code>'] },
];
const coreSinks = [
  { head: 'Command execution', cells: ['<code>system</code>, <code>exec</code>, <code>shell_exec</code>, <code>passthru</code>, <code>popen</code>, <code>proc_open</code>', 'Logs when not allowlisted'] },
  { head: 'Unserialize', cells: ['<code>unserialize</code>', '<strong>Off</strong>; opt in to log'] },
  { head: 'Include', cells: ['<code>include</code>, <code>require</code>', 'Inert until <code>allow_paths</code> is set'] },
  { head: 'Eval', cells: ['<code>eval</code>', 'Logs when reached'] },
  { head: 'Phar', cells: ['<code>phar://</code> via stream functions and <code>include</code>', '<strong>Off</strong>; opt in per sink'] },
  { head: 'SSRF', cells: ['<code>file_get_contents</code>, <code>fopen</code>, <code>get_headers</code>, <code>fsockopen</code>, <code>stream_socket_client</code>, curl', '<strong>Off</strong>; opt in per sink'] },
];
const behaviorFacets = [
  { head: 'Execution origin', cells: ['<code>deny_exec_dirs</code>', 'PHP run from a denied directory, as the requested script or <code>require</code>d by another'] },
  { head: 'Expected binaries', cells: ['<code>allow_exec_binaries</code>', '<code>exec</code>, <code>system</code>, <code>popen</code>, <code>proc_open</code>, <code>shell_exec</code>, <code>passthru</code> to a program not on the list'] },
  { head: 'Expected egress', cells: ['<code>allow_egress_hosts</code>', 'An outbound connection to a host not on the list'] },
  { head: '<code>.php</code> writes', cells: ['<code>deny_php_writes</code>', 'A PHP file written into a denied directory, or from a script that lives in one'] },
];
// Layer 3 by PHP version: every core sink detects and blocks on every
// generation; the footnotes carry the differences the old table spelled out.
const sinkVersions = [
  { sink: 'Command execution', marks: ['', '', ''] },
  { sink: '<code>unserialize</code> (off by default)', marks: ['', '', ''] },
  { sink: '<code>include</code> / <code>require</code>', marks: ['1', '', ''] },
  { sink: '<code>eval</code>', marks: ['', '', ''] },
  { sink: '<code>phar://</code> (off by default)', marks: ['2', '2', '3'] },
  { sink: 'SSRF (off by default)', marks: ['', '', ''] },
];
const aptLines = [
  'sudo install -d -m 0755 /etc/apt/keyrings',
  'curl -fsSL https://howdah.org/key.asc | sudo tee /etc/apt/keyrings/howdah.asc >/dev/null',
  `echo "deb [signed-by=/etc/apt/keyrings/howdah.asc] ${PKG}/apt stable main" \\`,
  '  | sudo tee /etc/apt/sources.list.d/howdah.list',
  'sudo apt-get update && sudo apt-get install php8.1-howdah',
];
---
<Layout
  title="Howdah: a defensive firewall for PHP"
  description="Howdah is an open-source, defensive firewall that loads into PHP itself. It blocks abusive upload and input floods before they exhaust memory, including on end-of-life PHP (5.4 to 8.1) that will not get the official fix."
  path="/"
>
  <div class="hero">
    <div class="wrap">
      <p class="eyebrow">Open source &middot; defensive &middot; in-process &middot; PHP 5.4 to 8.5</p>
      <h1>Hardening that loads <em>inside</em> PHP — even on the end-of-life versions most tools dropped.</h1>
      <p class="lede">Howdah is a Rust extension that runs in the PHP worker, so it sees a request <em>as PHP parses it</em>, before any of your code runs. That is the only place you can refuse an upload-part flood — the shape of the PHP2Shell attack — before it exhausts memory. It installs with one <code>extension=</code> line and runs on PHP 5.4 through 8.5, including the EOL branches that will never get the official fix.</p>
      <p class="fine">No agent, no sidecar, no telemetry, no cloud. Four layers, log-first by default: it recognizes and refuses abusive requests on the versions tested in the <a href="/coverage/">coverage table</a> &mdash; and nothing else.</p>
      <div class="cta">
        <a class="btn primary" href="/install/">Install Howdah {shortVersion}</a>
        <a class="btn ghost" href="/coverage/">See exactly what has been tested</a>
        <a class="btn ghost" href="/downloads/">Downloads &amp; images</a>
      </div>
    </div>
  </div>

  <section id="why" class="alt">
    <div class="wrap">
      <h2>Why Howdah is different</h2>
      <ul class="cardgrid">
        <li><div class="card">
          <h3>Inside PHP, not in front of it</h3>
          <p>Howdah runs in the PHP worker and counts upload parts and input variables <em>as PHP reads them</em>, so it can refuse a flood early. A network WAF or a PHP-level prepend only sees the request after PHP has already parsed it &mdash; too late for the PHP2Shell shape.</p>
        </div></li>
        <li><div class="card">
          <h3>Still runs on end-of-life PHP</h3>
          <p>One of the very few maintained in-process hardening extensions that still loads on PHP&nbsp;5.x and every 7.x. In August 2026, <a href="https://w3techs.com/technologies/details/pl-php" rel="nofollow">W3Techs</a> counted PHP&nbsp;5 and 7 on over a third of the PHP sites it measured (8.0% and 29.4%). Most hardening tools require 7.0 or newer.</p>
        </div></li>
        <li><div class="card">
          <h3>No agent, no telemetry, no cloud</h3>
          <p>One <code>extension=</code> line in <code>php.ini</code>. Nothing phones home, nothing to host, no SaaS account, no API key. Dual-licensed MIT or Apache-2.0.</p>
        </div></li>
        <li><div class="card">
          <h3>Log-first and honest</h3>
          <p>Four layers that detect and log by default; you turn on blocking when you are ready. Every &ldquo;blocked&rdquo; claim is backed by the public <a href="/coverage/">coverage table</a>, and releases are signed (and, from 1.5.0, SLSA-attested).</p>
        </div></li>
      </ul>
    </div>
  </section>

  <section id="what">
    <div class="wrap cols aside">
      <div>
        <h2>What is Howdah, and why the name?</h2>
        <p>Howdah is a native extension for PHP. When a web request arrives, PHP starts parsing it before any of your code runs. Howdah watches that parsing step and refuses requests that are built to exhaust memory, while PHP is still working through them.</p>
        <p>Its protection grew one layer at a time: request-shape limits in 1.0, input inspection in 1.1, sink hardening in 1.2 and 1.3, after-breach monitoring in 1.4, and scoped per-rule exceptions, structured logging and signed, SLSA-attested Docker builds in 1.5. Version 1.6 closes PHP2Shell itself: request-parsing limits that stop the amplifying shapes before PHP runs out of memory, and an out-of-memory backstop that exits the worker cleanly if it ever does &mdash; run against a vulnerable PHP build with Howdah active, the exploit does not land. <strong>Only the critical Layer-1 limits block by default; every other layer logs first</strong>, so you can watch what it would do before you let it act. The four layers are below.</p>
        <p>It is not a replacement for patching. Upgrade PHP when you can. Use Howdah when you cannot, or until you can.</p>
      </div>
      <aside class="card" aria-labelledby="howdah-word">
        <h3 id="howdah-word">A howdah?</h3>
        <p>A howdah is the covered seat strapped onto an elephant's back: a small armoured shelter that carries someone safely. PHP's mascot is an elephant, so the name fits. Howdah sits on PHP's back and shields what is riding on it.</p>
        <p>Howdah is an independent project. It is not made by, or endorsed by, the PHP project.</p>
      </aside>
    </div>
  </section>

  <section id="how" class="alt">
    <div class="wrap">
      <h2>How it works: four layers</h2>
      <p>Howdah's protection is organised in four layers. <strong>Version 1.0 delivered Layer 1; version 1.1 added Layer 2; version 1.2 added Layer 3, extended in 1.3; version 1.4 added Layer 4.</strong> Layer 2 detects and logs SQL injection, path traversal and command/code injection in request values; Layer 3 guards dangerous sinks (command execution, <code>unserialize</code>, <code>include</code>, <code>eval</code>, and in 1.3 <code>phar://</code> and SSRF); Layer 4 watches what PHP does after a breach (PHP run from upload directories, unexpected binaries and outbound hosts, <code>.php</code> writes). None of the three blocks by default.</p>

      <figure class="diagram">
        <svg viewBox="0 0 760 250" role="img" aria-labelledby="diag-title diag-desc">
          <title id="diag-title">Where Howdah runs</title>
          <desc id="diag-desc">A request passes a network WAF, then enters the PHP worker, where PHP parses it and runs your script. Howdah's four layers run inside the worker; a network WAF or a PHP-level prepend only see the request after PHP has parsed it.</desc>
          <defs>
            <marker id="diag-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" class="d-flowfill"/></marker>
          </defs>
          <!-- incoming request -->
          <text x="4" y="126" class="d-tm">Request</text>
          <line x1="4" y1="136" x2="92" y2="136" class="d-flow" marker-end="url(#diag-arrow)"/>
          <!-- network WAF: outside PHP -->
          <rect x="100" y="104" width="150" height="66" rx="9" class="d-ext"/>
          <text x="175" y="132" text-anchor="middle" class="d-tm d-strong">Network WAF</text>
          <text x="175" y="150" text-anchor="middle" class="d-tm">raw bytes,</text>
          <text x="175" y="164" text-anchor="middle" class="d-tm">before PHP</text>
          <line x1="250" y1="136" x2="290" y2="136" class="d-flow" marker-end="url(#diag-arrow)"/>
          <!-- PHP worker: Howdah lives here -->
          <rect x="292" y="48" width="464" height="162" rx="12" class="d-wkr"/>
          <text x="308" y="74" class="d-th">PHP worker process</text>
          <text x="748" y="74" text-anchor="end" class="d-tm">Howdah runs in here</text>
          <text x="308" y="104" class="d-tm">PHP parses the request</text>
          <text x="492" y="104" class="d-tm">your PHP script runs</text>
          <line x1="308" y1="120" x2="742" y2="120" class="d-flow" marker-end="url(#diag-arrow)"/>
          <line x1="474" y1="92" x2="474" y2="196" class="d-div"/>
          <!-- layer chips -->
          <g>
            <rect x="308" y="134" width="150" height="40" rx="8" class="d-chip d-chip-hot"/>
            <text x="383" y="159" text-anchor="middle" class="d-t d-strong">Layer 1</text>
            <rect x="490" y="134" width="80" height="40" rx="8" class="d-chip"/>
            <text x="530" y="159" text-anchor="middle" class="d-t">Layer 2</text>
            <rect x="578" y="134" width="80" height="40" rx="8" class="d-chip"/>
            <text x="618" y="159" text-anchor="middle" class="d-t">Layer 3</text>
            <rect x="666" y="134" width="80" height="40" rx="8" class="d-chip"/>
            <text x="706" y="159" text-anchor="middle" class="d-t">Layer 4</text>
          </g>
          <!-- auto_prepend marker -->
          <line x1="474" y1="210" x2="474" y2="228" class="d-div"/>
          <text x="474" y="244" text-anchor="middle" class="d-tm"><tspan class="d-mono">auto_prepend_file</tspan> starts here — after parsing</text>
        </svg>
        <figcaption>A network WAF or a PHP-level prepend only sees a request <em>after</em> PHP has parsed it. Howdah runs inside the worker, so <strong>Layer 1 counts upload parts as PHP reads them</strong> and refuses a flood before it exhausts memory — then Layers 2&ndash;4 watch the request and the code as they run.</figcaption>
      </figure>
      <ol class="layers" aria-label="The four protection layers; a request flows from the top down">
        {layers.map((l) => (
          <li class={l.status}>
            <span class="lnum" aria-hidden="true">{l.n}</span>
            <div>
              <h3>Layer {l.n}: {l.name} {l.status === 'active' ? <span class="pill ok">Active in 1.0</span> : l.status === 'released' ? <span class="pill ok">Active in {l.n === 4 ? '1.4' : l.n === 3 ? '1.2' : '1.1'} · log-only</span> : <span class="pill na">Planned</span>}</h3>
              <p>{l.covers}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="legend">A request enters at Layer 1. Because Howdah runs inside PHP's own request handling, Layer 1 can count upload parts and input variables <em>as PHP reads them</em> and stop the request early — something a PHP-level script or a network box cannot do (see the PHP2Shell story below).</p>
    </div>
  </section>

  <section id="enforces">
    <div class="wrap">
      <h2>Layer 1 — what Howdah enforces</h2>
      <p>These are the Layer-1 default limits. A request that crosses a limit has the offending data dropped and is logged; in block mode (or for a Critical rule in any mode) it is also refused with HTTP 403/413 and a request ID that matches the log line. Every limit is configurable in a TOML file; the <a href="/config/">config editor</a> builds and validates one in the browser. Numbers below are the shipped defaults.</p>
      <div class="cols two" style="margin-top:1.5rem">
        <div>
          <h3>Multipart upload limits</h3>
          <FitTable caption="Multipart upload default limits" cols={['Limit', 'Default', 'Stops']} rows={multipartLimits} />
          <p class="legend">Enforced <strong>while PHP parses the body</strong>, before per-part memory is allocated — the 403/413 lands before your script runs. Since 1.6 a raw-body scanner enforces <code>max_part_headers</code> and <code>max_part_header_bytes</code> on <em>every</em> part header (earlier only the <code>Content-Disposition</code> header reached the extension).</p>
        </div>
        <div>
          <h3>Input-shape &amp; request-header limits</h3>
          <FitTable caption="Input-shape and request-header default limits" cols={['Limit', 'Default', 'Stops']} rows={inputLimits} />
          <p class="legend"><strong>Honest caveat:</strong> the input-shape limits <strong>drop the offending variable</strong> (bounding the symbol table), log it, and refuse the request before your script runs. The request-header limits drop nothing: they log, and when the script builds <code>$_SERVER</code> itself and Layer 2 is not armed, the 403 is set at request shutdown, after the script; there the log line is the signal. See <a href="/docs/configuration/#enforcement-timing">enforcement timing</a>.</p>
        </div>
      </div>
      <p class="legend" style="margin-top:1.5rem"><strong>Modes &amp; severity.</strong> Critical rules (the unambiguous resource-exhaustion shapes) block even in <code>detect</code> mode; Standard rules log in detect and block only in <code>block</code> mode. This is why a &ldquo;start in detect&rdquo; rollout still refuses the critical resource-exhaustion shapes while you watch everything else. (Run against a vulnerable PHP build with Howdah active, the PHP2Shell exploit does not land &mdash; see the <a href="/blog/php2shell-explained/">PHP2Shell explainer</a> and the <a href="/coverage/">coverage page</a>.) Full directive and rule reference: <a href="/docs/configuration/">Configuration</a>.</p>
    </div>
  </section>

  <section id="inspection">
    <div class="wrap">
      <h2>Layer 2 — what Howdah inspects <span class="pill ok">1.1 · log-only</span></h2>
      <p>Layer 1 limits the <em>shape</em> of a request. Layer 2 looks at the <em>content</em> of decoded request values: GET query parameters, POST fields, cookies and the URL path, through the same request hook Layer 1 uses. <strong>It detects and logs; it does not block by default.</strong></p>
      <div class="cols two" style="margin-top:1.5rem">
        <div>
          <h3>Three classes of pattern</h3>
          <FitTable caption="Layer 2 detection classes with illustrative shapes" cols={['Class', 'Rule name', 'Example shape']} rows={inspectClasses} />
          <p class="legend">The examples illustrate each shape; they are not a complete list of what is matched. Cross-site scripting (XSS) is <strong>not</strong> covered.</p>
          <h3 style="margin-top:1.5rem">How detection works</h3>
          <p>A small, high-confidence signature scan that runs in linear time, so there is no catastrophic backtracking. Work is bounded per value and per request, so the scan itself cannot be turned into a denial of service; values past a budget are not scanned.</p>
        </div>
        <div>
          <h3>Log-first, on purpose</h3>
          <p>Layer 2 has its own <code>inspect.mode</code>, which defaults to <code>detect</code> (log only). It is independent of the global <code>howdah.mode</code>: setting <code>howdah.mode = block</code> does <strong>not</strong> arm it. To block, an operator sets <code>inspect.mode</code>, or one class, to <code>block</code> explicitly.</p>
          <h3 style="margin-top:1.5rem">What a detection looks like</h3>
          <p>One JSON log line carrying the rule class, the source (<code>get</code>, <code>post</code>, <code>cookie</code> or <code>path</code>) and the variable name. The matched value is never logged.</p>
          <pre class="fold hang" data-sample="event"><code>{`{"action":"log","client_ip":"203.0.113.7","layer":2,"method":"GET","reason":"sql_injection pattern in get variable 'q'","request_id":"1a2d239820e2f06bc","rule":"sql_injection","schema":2,"ts":"1792864974146","uri":"/index.php","version":"1.6.1"}`}</code></pre>
          <p class="legend">From a lab run (PHP 7.4, php-fpm, request <code>/index.php?q=' OR 1=1 --</code>). The query string is stripped from the logged <code>uri</code>; for a path detection the path itself is the logged URI. Every field: <a href="/docs/configuration/#log">event log reference</a>.</p>
        </div>
      </div>
      <p class="legend" style="margin-top:1.5rem"><strong>Honest caveat.</strong> Signature inspection is best-effort and can be bypassed, which is exactly why Layer 2 logs rather than blocks. Use the log to see what is happening, and fix the application (parameterized queries, path normalization, no shell calls on user input). To configure or enable it, see the <code>[inspect]</code> section of the <a href="/docs/configuration/#layer-2-inspection">configuration reference</a>.</p>
    </div>
  </section>

  <section id="sinks" class="alt">
    <div class="wrap">
      <h2>Layer 3 — the sinks Howdah guards <span class="pill ok">since 1.2 · log-only</span></h2>
      <p>Layer 2 looks at request values. Layer 3 looks at what the application does with them: it guards dangerous PHP functions, called <em>sinks</em>, with a flat allowlist policy in the style of Snuffleupagus. Howdah <strong>guards six core sinks (three of them off by default), plus seven legacy sinks added in 1.5. It detects and logs; it does not block by default.</strong> This is sink hardening, not XSS or output inspection.</p>
      <div class="cols two" style="margin-top:1.5rem">
        <div>
          <h3>The six core sinks</h3>
          <FitTable caption="Layer 3 core sinks" cols={['Sink', 'Functions', 'Default']} rows={coreSinks} />
          <p class="legend">Known limitation: <code>proc_open</code> with an array command (PHP 7.4+) is not inspected.</p>
          <p class="legend"><strong>Seven legacy sinks (new in 1.5), all log-first:</strong> <code>mail_injection</code>, <code>preg_eval</code> (PHP 5.x), <code>create_function</code> and <code>assert_string</code> (5.x/7.x), <code>dangerous_callback</code>, <code>xxe</code> (with <code>[sinks.xml] external_entities</code>), and <code>tls_verify</code> (detect-only). See the <a href="/docs/configuration/#layer-3-sinks">configuration reference</a> for each one's PHP-version applicability and defaults.</p>
          <h3 style="margin-top:1.5rem">Coverage by PHP version</h3>
          <div class="vmatrix">
            <table>
              <caption class="sr-only">Layer 3 sink coverage by PHP version: every cell is detect and block</caption>
              <thead><tr><th scope="col">Sink</th><th scope="col">PHP <span class="nw">5.4–5.6</span></th><th scope="col">PHP <span class="nw">7.0–7.4</span></th><th scope="col">PHP <span class="nw">8.0–8.5</span></th></tr></thead>
              <tbody>
                {sinkVersions.map((s) => (
                  <tr>
                    <th scope="row" set:html={s.sink} />
                    {s.marks.map((m) => <td><span class="mark" aria-hidden="true">✓</span><span class="sr-only">detect and block{m && `, note ${m}`}</span>{m && <sup aria-hidden="true">{m}</sup>}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="legend"><span aria-hidden="true">✓</span> = detect and block (when armed). <sup>1</sup>&nbsp;Checked at compile time: a file served from a warm opcache is not re-inspected (on PHP 7.0+ only with <code>hook = "compile"</code>). <sup>2</sup>&nbsp;Includes phar metadata deserialization through the stream wrapper. <sup>3</sup>&nbsp;Detection and denial of <code>phar://</code> use only; no deserialization claim.</p>
          <p class="legend">Verified on PHP 5.4, 5.6, 7.4, 8.3 and 8.5; other minors build and are expected to work but are not independently verified. A debug-build leak review is pending. Blocking an include or eval stops it running and the script continues. <strong>PHP 5.x <code>include</code> is checked at compile time, so a file served from a warm opcache is not re-inspected</strong> (<code>eval</code> is unaffected; the 7.0+ opcode handler is not affected by opcache, but with <code>[sinks] hook = "compile"</code> PHP 7.0+ has the same warm-opcache limit). <strong>Phar:</strong> on PHP 5.x/7.x this covers metadata deserialization via the stream wrapper; on 8.x it is detection and denial of <code>phar://</code> use only. The direct Phar API (<code>new Phar</code>, <code>PharData</code>, <code>Phar::loadPhar</code>, <code>Phar::mapPhar</code>, <code>Phar::getMetadata</code>) is not covered. <strong>SSRF</strong> is best-effort, resolve-at-check-time detection, not a connection-time boundary: DNS rebinding, redirects, <code>curl_multi_*</code>, <code>CURLOPT_RESOLVE</code>/<code>CONNECT_TO</code> and a non-string or absent <code>CURLOPT_URL</code> bypass it, and <code>copy</code>, <code>file</code>, <code>readfile</code>, <code>SoapClient</code>, <code>DOMDocument::load*</code> and <code>simplexml_load_file</code> are not hooked. It adds a DNS lookup per distinct outbound host with no timeout. More detail on the <a href="/coverage/">coverage page</a>.</p>
        </div>
        <div>
          <h3>Log-first, on purpose</h3>
          <p>Layer 3 has its own <code>sinks.mode</code>, which defaults to <code>detect</code> (log only). It is independent of the global <code>howdah.mode</code>: setting <code>howdah.mode = block</code> does <strong>not</strong> arm sinks. Every active sink except <code>tls_verify</code> (detect-only) can block, and only when an operator sets that sink to <code>block</code> explicitly, after setting its allowlist. The 1.3 <code>phar</code> and <code>ssrf</code> sinks are off by default and only an explicit per-sink mode arms them.</p>
          <h3 style="margin-top:1.5rem">The argument is never logged</h3>
          <p>An event records the sink and the function name (plus the class name for <code>unserialize</code>). The command line and the serialized payload are never written to the log.</p>
        </div>
      </div>
      <p class="legend" style="margin-top:1.5rem"><strong>Honest caveat.</strong> A flat allowlist policy is best-effort virtual patching and can be bypassed, which is why Layer 3 logs rather than blocks. Use the log to learn what your application really calls, then fix the application (no shell calls on user input, no unserialize of untrusted data). To configure it, see the <code>[sinks]</code> section of the <a href="/docs/configuration/#layer-3-sinks">configuration reference</a>.</p>
    </div>
  </section>

  <section id="behavior">
    <div class="wrap">
      <h2>Layer 4 — what Howdah watches after a breach <span class="pill ok">1.4 · log-only</span></h2>
      <p>Layers 1 to 3 try to stop the attack. Layer 4 assumes something got through, such as a webshell uploaded into a writable directory, and watches what PHP then does. <strong>It detects and logs; it does not block by default, and it does nothing until you set its lists.</strong> Events name the script that made the call, so a finding points at the webshell even when a legitimate script <code>require</code>d it.</p>
      <div class="cols two" style="margin-top:1.5rem">
        <div>
          <h3>Four things it watches</h3>
          <FitTable caption="Layer 4 facets in 1.4" cols={['Facet', 'Setting', 'Flags']} rows={behaviorFacets} />
          <p class="legend">Lab-verified on PHP 5.4, 5.6, 7.4, 8.3, 8.4 and 8.5: 27 checks per version, covering each facet in <code>detect</code> and <code>block</code>, that a framework-style view write and a plain read of a <code>.php</code> file are not flagged, and that the default configuration is inert. Other minors are not independently verified. More detail on the <a href="/coverage/">coverage page</a>.</p>
        </div>
        <div>
          <h3>Hybrid policy: you set it, Howdah helps you find it</h3>
          <p>You supply the allowlists (<code>allow_exec_binaries</code>, <code>allow_egress_hosts</code>) and the denied directories. To learn what your application really does, set <code>observe = true</code>: Howdah logs each would-be finding as a <code>proposed</code> line, such as the binary that was run or the host contacted, which you can fold into the lists. Observe never blocks and never edits your config, and its output needs your review.</p>
          <h3 style="margin-top:1.5rem">Log-first, on purpose</h3>
          <p>Layer 4 has its own <code>behavior.mode</code>, which defaults to <code>detect</code> (log only). It is independent of the global <code>howdah.mode</code>: setting <code>howdah.mode = block</code> does <strong>not</strong> arm it. Every list ships empty, so a fresh install blocks nothing.</p>
        </div>
      </div>
      <p class="legend" style="margin-top:1.5rem"><strong>Honest caveat.</strong> Howdah only sees what PHP itself does: a process PHP launches and then detaches, a reverse shell that forks away, or a dropper that never ran through PHP is invisible to Layer 4. For <code>deny_exec_dirs</code>, the requested-script case does not depend on opcache, but the <code>require</code>d-file case is checked at first compile and is best-effort, so a file served from a warm opcache may not be re-checked. Allowlists are best-effort and can be bypassed. The <code>.php</code>-write facet is scoped by origin and can still flag frameworks that compile templates into a denied directory, so scope it before you use <code>block</code>. Observe only proposes. To configure it, see the <code>[behavior]</code> section of the <a href="/docs/configuration/#layer-4-behavior">configuration reference</a>.</p>
    </div>
  </section>

  <section id="story">
    <div class="wrap">
      <h2>The PHP2Shell story, plainly told</h2>
      <div class="cols two">
        <div>
          <p>On 21 October 2026 the PHP project patched two linked flaws, CVE-2026-109618 and CVE-2026-109619, which security researchers named PHP2Shell. As the official advisories describe it, a crafted <code>multipart/form-data</code> request drives PHP's parser to run out of memory while it reads the body — a body well under the default 8&nbsp;MB limit can still hold thousands of tiny parts, deeply nested names, or a part with a flood of headers. PHP handles running out of memory with a <code>longjmp</code> that can leave the half-built request in a corrupt state, which the advisories say can be turned into remote code execution without logging in.</p>
          <p>The official fix ships for PHP 8.2 and newer; older branches get no official patch. PHP 8.1 and older still run a very large share of the web.</p>
          <div class="note">
            <h3>What we verified</h3>
            <p>We ran the PHP2Shell exploit against a vulnerable PHP build with Howdah loaded in its default configuration, and it <strong>did not land</strong>. Howdah 1.6 added the two protections this needs: request-parsing limits that refuse the amplifying shapes before PHP runs out of memory, and an out-of-memory backstop that exits the worker cleanly if it ever does.</p>
            <p>We also measured the shape directly: PHP's own <code>max_input_vars</code> and <code>max_file_uploads</code> keep the flood small on a default box; with those caps raised, the same shape used 127 to 173&nbsp;MB against a 128&nbsp;MB limit, and Howdah's default limits refuse it long before that. See the <a href="/coverage/">coverage table</a>, the <a href="/blog/php2shell-explained/">explainer</a> and <a href={`${REPO}/blob/main/docs/coverage-data.md`}>the measurements</a>.</p>
          </div>
        </div>
        <div>
          <h3 style="margin-top:0">Why only a PHP extension can stop it</h3>
          <ul class="facts">
            <li>PHP reads the whole upload into <code>$_FILES</code> and <code>$_POST</code> before any PHP script runs, so a firewall written in PHP (for example via <code>auto_prepend_file</code>) is too late.</li>
            <li><code>opcache.preload</code> runs once when the server starts, never per request.</li>
            <li>A network firewall sees bytes on the wire, not how PHP will interpret them.</li>
            <li>A compiled extension runs inside PHP's own upload parser, so it can count parts as PHP reads them and stop the request early.</li>
          </ul>
          <p style="margin-top:1rem;font-size:.95rem">The incident details above come from public reports. We are checking them against the official advisories (GHSA-w8hw-w9fx-j79w, GHSA-6wmf-4rv5-p3rp, php.net) and will correct this page if they differ.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="versions">
    <div class="wrap">
      <h2>Version support: PHP 5.4 to 8.5</h2>
      <p>Howdah ships one build per PHP minor version. A version marked <strong>Tested</strong> has a passing lab result{ranDate && <> (matrix run {ranDate}{coverage.matrixVersion && <> on Howdah {coverage.matrixVersion}</>})</>}; a version marked <strong>Expected</strong> shares a generation's code path with a tested version but has not been independently run, so it is not claimed as a test result. The <a href="/coverage/">coverage page</a> has the full per-server-type detail.</p>
      <ul class="matrix" aria-label="PHP version support">
        {rows.map((r: any) => (
          <li>
            <span class="v">{r.version ?? r.minor}</span>
            {r.version
              ? <span class="pill ok">Tested</span>
              : <span class="pill na">Expected</span>}
          </li>
        ))}
      </ul>
      <p class="legend">Linux x86_64 and aarch64, non-thread-safe (NTS) builds &mdash; glibc for the broadest reach and musl for Alpine. Published as signed, SLSA-attested tarballs, apt/yum packages, and Docker images. The exact per-architecture binaries are whatever the release build produced &mdash; see the <a href="/install/">install picker</a> and the release assets.</p>
    </div>
  </section>

  <section id="compare" class="alt">
    <div class="wrap">
      <h2>How Howdah compares</h2>
      <p>Howdah does a narrow set of things well: request-shape limits that block, plus log-first input inspection, sink hardening and after-breach checks &mdash; all from inside PHP, on versions most tools no longer cover. It is not a general-purpose WAF. Here is where it sits among tools people reach for, as of {compareAsOf}.</p>
      <FitTable stack="wide" caption={`How Howdah compares with other PHP protection tools, as of ${compareAsOf}`} cols={['Tool', 'Where it runs', 'License', 'Main job', 'Runs on EOL PHP (5.4–8.1)?', 'External service']} rows={compareRows} />
      <p class="legend">Compiled {compareAsOf} from each project's own documentation: Snuffleupagus (snuffleupagus.readthedocs.io), OpenRASP (github.com/baidu/openrasp), Aikido Zen (github.com/AikidoSec/firewall-php), ModSecurity &amp; OWASP CRS (owasp.org / owasp-modsecurity), Datadog (docs.datadoghq.com). These tools do more than Howdah in their own areas; Howdah's point is the narrow, in-PHP, EOL-friendly niche. Found something out of date? <a href={`${REPO}/issues`}>Tell us</a>.</p>
    </div>
  </section>

  <section id="coverage">
    <div class="wrap">
      <h2>Coverage: what has actually been tested</h2>
      <p>Every result is generated from the test matrix, never hand-typed. Totals: <strong>{coverage.totals.pass}</strong> checks passed, <strong>{coverage.totals.fail}</strong> failed, <strong>{coverage.totals.skip}</strong> skipped, with <strong>{coverage.corpusFalsePositives}</strong> false positives across the legitimate-upload corpus. A version is only called &ldquo;Blocked&rdquo; where the test for that exact version and server type passed; untested versions are marked plainly and never claimed as protected.</p>
      <p><a class="btn ghost" href="/coverage/">Read the full coverage table</a></p>
    </div>
  </section>

  <section id="install" class="alt">
    <div class="wrap">
      <h2>Install in a minute</h2>
      <p>On Debian/Ubuntu with the apt repository (one build per PHP minor; replace <code>8.1</code> with yours). The key is pinned to this repo only:</p>
      <pre class="fold"><code>{aptLines.map((l) => <span class="l">{l}</span>)}</code></pre>
      <p>On RHEL/CentOS/Alma (Remi layout) the package is <code>php81-howdah</code> via <code>yum</code>, with both package and metadata signatures enforced. Both package names, the exact <code>.repo</code> file, the signed-tarball path for other setups, and the verify/rollback steps are in the picker. Once it is installed, the config editor writes your <code>howdah.ini</code> and <code>howdah.toml</code> from a form and checks the TOML with the extension's own parser.</p>
      <p>Prefer containers? Pull a ready-made image &mdash; Howdah is installed and enabled in detect mode:</p>
      <pre class="fold hang"><code>docker pull ghcr.io/howdah/howdah:{VERSION}-php8.3</code></pre>
      <p>Images cover PHP 5.6&ndash;8.5 (Debian, amd64 + arm64); an <code>-alpine</code> variant covers PHP 7.2&ndash;8.5 (amd64). Or use a signed, SLSA-attested tarball for any other setup &mdash; every method is in the <a href="/install/#docker">install picker</a>.</p>
      <div class="cta"><a class="btn primary" href="/install/">Open the install picker</a> <a class="btn ghost" href="/config/">Build your config file</a> <a class="btn ghost" href="/coverage/">Check your PHP version first</a></div>
    </div>
  </section>
