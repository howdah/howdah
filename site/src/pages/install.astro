---
import Layout from '../layouts/Layout.astro';
import { PKG, KEY_FPR, RELEASES, VERSION } from '../lib/site';

const MINORS = ['5.4','5.5','5.6','7.0','7.1','7.2','7.3','7.4','8.0','8.1','8.2','8.3','8.4','8.5'];
---
<Layout
  title="Install Howdah — pick your OS, PHP and server"
  description="Get the exact install, verify and rollback commands for Howdah on your OS, PHP version, PHP source and server type (FPM, Apache, CGI) — apt, yum, a signed tarball, or a public Docker image."
  path="/install/"
>
  <div class="pagehead">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / <span aria-current="page">Install</span></p>
      <h1>Install Howdah</h1>
      <p class="lede">Choose your system and get the exact commands to install, verify and roll back — one build per PHP minor version. Start in <code>detect</code> mode; the critical limits still block.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <form id="picker" class="picker" aria-label="Choose your setup">
        <fieldset>
          <legend>1. Operating system</legend>
          <label><input type="radio" name="os" value="debian" checked /> Debian / Ubuntu <small>Ubuntu 16.04–24.04, Debian 11–12, Surý or the distribution's PHP — installs with <b>apt</b></small></label>
          <label><input type="radio" name="os" value="rhel" /> RHEL / CentOS / Alma / Rocky with Remi PHP <small>CentOS 7, Alma/Rocky 8–9, Remi's <code>php74</code>-style collections — installs with <b>yum/dnf</b></small></label>
          <label><input type="radio" name="os" value="el" /> RHEL / Alma / Rocky / Amazon Linux, distribution PHP <small>The OS's own <code>php</code> in <code>/usr/bin</code> — installs with <b>yum/dnf</b></small></label>
          <label><input type="radio" name="os" value="cpanel" /> cPanel (EasyApache 4) <small>cPanel's <code>ea-php</code> versions — installs with <b>dnf/yum</b> or <b>apt</b>, not the EasyApache 4 screen</small></label>
          <label><input type="radio" name="os" value="plesk" /> Plesk <small>Plesk's PHP versions in <code>/opt/plesk/php</code> — installs with <b>dnf/yum</b> or <b>apt</b></small></label>
          <label><input type="radio" name="os" value="cloudlinux" /> CloudLinux alt-php <small>PHP Selector versions in <code>/opt/alt</code> — installs with <b>yum</b></small></label>
          <label id="docker"><input type="radio" name="os" value="docker" /> Docker <small>The official <code>php</code> images — a ready <b>image</b>, or one <code>COPY --from</code> line in your own Dockerfile</small></label>
          <label><input type="radio" name="os" value="other" /> DirectAdmin / other <small>DirectAdmin CustomBuild, LiteSpeed lsphp, self-built PHP, older distros — install from the <b>signed tarball</b></small></label>
        </fieldset>

        <fieldset data-when-os="cpanel plesk" hidden>
          <legend>2. Server operating system</legend>
          <label><input type="radio" name="panel_os" value="el" checked /> AlmaLinux / Rocky / CloudLinux / CentOS <small>Installs with <b>dnf</b> (or <b>yum</b> on CentOS 7)</small></label>
          <label><input type="radio" name="panel_os" value="deb" /> Ubuntu / Debian <small>Installs with <b>apt</b></small></label>
        </fieldset>

        <fieldset data-when-os="debian">
          <legend>2. Where your PHP comes from</legend>
          <label><input type="radio" name="src_deb" value="sury" checked /> Surý PPA / deb.sury.org <small>The usual source for modern PHP on Debian/Ubuntu</small></label>
          <label><input type="radio" name="src_deb" value="distro" /> The distribution's own PHP <small>Same package format; use the tarball if your API number has no matching build</small></label>
        </fieldset>

        <fieldset data-when-os="debian" hidden>
          <legend>Ubuntu 16.04 (xenial)?</legend>
          <label><input type="checkbox" name="xenial" value="1" /> This is Ubuntu 16.04 <small>Uses the older apt key method (apt 1.2 needs <code>apt-transport-https</code> and <code>apt-key</code>)</small></label>
        </fieldset>

        <fieldset>
          <legend><span data-os-step>3</span>. PHP version</legend>
          <label for="minor">PHP minor version (from <code>php -v</code>)</label>
          <select id="minor" name="minor">
            {MINORS.map((m) => <option value={m} selected={m === '8.1'}>{m}</option>)}
          </select>
        </fieldset>

        <fieldset>
          <legend><span data-os-step2>4</span>. Server type (SAPI)</legend>
          <label><input type="radio" name="sapi" value="fpm" checked /> PHP-FPM <small>The common setup behind Nginx or Apache</small></label>
          <label><input type="radio" name="sapi" value="apache" /> Apache mod_php <small>prefork mpm</small></label>
          <label><input type="radio" name="sapi" value="cgi" /> php-cgi / FastCGI <small>See the note about CVE-2012-1823 below</small></label>
        </fieldset>
      </form>

      <h2 id="result-heading">Your commands</h2>
      <p class="js-note" data-nojs>Showing the default: Debian/Ubuntu + Surý + PHP 8.1 + PHP-FPM. With JavaScript, the commands below update as you change the choices above. Without it, follow the full per-platform guide in the <a href="/docs/">docs</a>.</p>
      <p class="legend">The package ships with <code>howdah.mode = detect</code>. When you want to change limits or turn a layer on, the <a href="/config/">config editor</a> builds a validated <code>howdah.toml</code> and the matching ini lines, with a <code>curl</code> command to fetch it.</p>
      <div id="result" aria-live="polite" aria-labelledby="result-heading">
        <!-- Server-rendered default (works with no JavaScript). The script replaces this. -->
        <ol class="steps" id="result-steps">
          <li>
            <h3>Add the signed apt repository</h3>
            <p>The key is pinned to this repository only.</p>
            <pre tabindex="0"><code>sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://howdah.org/key.asc | sudo tee /etc/apt/keyrings/howdah.asc &gt;/dev/null
echo "deb [signed-by=/etc/apt/keyrings/howdah.asc] {PKG}/apt stable main" \
  | sudo tee /etc/apt/sources.list.d/howdah.list</code></pre>
          </li>
          <li>
            <h3>Install the package for your PHP</h3>
            <pre tabindex="0"><code>sudo apt-get update
sudo apt-get install php8.1-howdah</code></pre>
            <p>The package installs only against a PHP with the matching ABI, and enables the module for PHP 8.1.</p>
          </li>
          <li>
            <h3>Verify it is loaded, then reload your server</h3>
            <pre tabindex="0"><code>php -m | grep -i howdah
php --ri howdah          <span class="c"># Howdah =&gt; enabled, Mode =&gt; detect</span>
sudo systemctl reload php8.1-fpm</code></pre>
          </li>
          <li>
            <h3>Roll back at any time</h3>
            <pre tabindex="0"><code>sudo phpdismod -v 8.1 howdah        <span class="c"># stop loading, keep the package</span>
sudo apt-get purge php8.1-howdah    <span class="c"># or remove everything</span>
sudo systemctl reload php8.1-fpm</code></pre>
          </li>
        </ol>
      </div>

      <p id="distro-note" class="legend" hidden>Your PHP comes from the distribution, not Surý. The same package fits: Debian's and Ubuntu's PHP packages provide the same <code>phpapi-N</code> ABI marker and use the same paths (checked with Ubuntu 20.04's own PHP 7.4).</p>

      <p id="layout-note" class="legend" hidden>These panel and distribution repositories are new and are published with the next release of the repositories. If the repository URL does not answer yet, use the signed tarball (<b>DirectAdmin / other</b> above); <code>howdah-check detect</code> names the right one either way. Paths, sources and what was tested: <a href="https://github.com/howdah/howdah/blob/main/docs/packaging-layouts.md">packaging layouts</a>.</p>

      <p id="docker-note" class="legend" hidden>The images are public at <code>ghcr.io/howdah/howdah</code>: pull <code>{VERSION}-php&lt;minor&gt;</code> (Debian, PHP&nbsp;5.6&ndash;8.5, amd64&nbsp;+&nbsp;arm64) or the <code>-alpine</code> variant (PHP&nbsp;7.2&ndash;8.5, amd64). Each image has Howdah installed and enabled in detect mode. Tags, the one-line <code>COPY --from</code> recipe for your own image, how to verify an image against the signed release, and what was tested: <a href="https://github.com/howdah/howdah/blob/main/docs/install-docker.md">Docker install guide</a>.</p>

      <div class="note" id="cgi-note" hidden>
        <h3>A note for php-cgi / FastCGI</h3>
        <p>Howdah protects the request-parsing path the same way under CGI. It cannot cover <strong>CVE-2012-1823</strong> (php-cgi argument injection): that query string is consumed by php-cgi during its own startup, <em>before</em> any PHP extension loads, so no in-PHP firewall can act on it. Use a web-server or front-proxy rule, or a patched php-cgi, for that one. See the <a href="/coverage/">coverage page</a>.</p>
      </div>

      <p class="legend">The signing key is at <code>https://howdah.org/key.asc</code> — the same key that signs the release <code>SHA256SUMS</code>. Check its primary fingerprint, <code>{KEY_FPR}</code>, before trusting it. Package and metadata signatures are both enforced. Build provenance and rebuilding a release yourself: <a href="/docs/verify/">verify a release</a>.</p>
    </div>
  </section>
</Layout>

<script define:vars={{ PKG, RELEASES, VERSION }}>
  const form = document.getElementById('picker');
  const result = document.getElementById('result-steps');
  const cgiNote = document.getElementById('cgi-note');
  const distroNote = document.getElementById('distro-note');
  const layoutNote = document.getElementById('layout-note');
  const dockerNote = document.getElementById('docker-note');
  const jsNote = document.querySelector('[data-nojs]');
  if (jsNote) jsNote.textContent = 'These commands update as you change the choices above. One build per PHP minor version.';

  const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const val = (name) => form.elements[name] && form.elements[name].value;
  const checked = (name) => form.elements[name] && form.elements[name].checked;

  // Build one <li> with a heading and a code block (comments marked with ⍘ → .c span).
  function step(title, body, lines) {
    const code = lines.map((l) => {
      const i = l.indexOf('# ');
      if (i > 0) return `${esc(l.slice(0, i))}<span class="c">${esc(l.slice(i))}</span>`;
      if (l.startsWith('# ')) return `<span class="c">${esc(l)}</span>`;
      return esc(l);
    }).join('\n');
    return `<li><h3>${esc(title)}</h3>${body ? `<p>${body}</p>` : ''}<pre tabindex="0"><code>${code}</code></pre></li>`;
  }

  function render() {
    const os = val('os');
    const minor = val('minor');          // e.g. 8.1
    const xy = minor.replace('.', '');    // e.g. 81
    const sapi = val('sapi');
    cgiNote.hidden = sapi !== 'cgi';
    distroNote.hidden = !(os === 'debian' && val('src_deb') === 'distro');
    layoutNote.hidden = !['el', 'cpanel', 'plesk', 'cloudlinux'].includes(os);
    dockerNote.hidden = os !== 'docker';

    // show/hide os-conditional fieldsets (data-when-os lists the os values,
    // space-separated) + the xenial question
    form.querySelectorAll('[data-when-os]').forEach((fs) => {
      const show = fs.getAttribute('data-when-os').split(' ').includes(os);
      // the xenial fieldset is the second debian one — toggle both with os
      fs.hidden = !show;
    });

    // the signed-key setup shared by every yum/dnf and apt repository below
    const yumRepo = (id, name, path) => ['sudo rpm --import https://howdah.org/key.asc',
      `sudo tee /etc/yum.repos.d/${id}.repo >/dev/null <<'REPO'`,
      `[${id}]`, `name=${name}`, `baseurl=${PKG}/${path}/yum`,
      'enabled=1', 'gpgcheck=1', 'repo_gpgcheck=1', 'gpgkey=https://howdah.org/key.asc', 'REPO'];
    const aptRepo = (id, path) => ['sudo install -d -m 0755 /etc/apt/keyrings',
      'curl -fsSL https://howdah.org/key.asc | sudo tee /etc/apt/keyrings/howdah.asc >/dev/null',
      `echo "deb [signed-by=/etc/apt/keyrings/howdah.asc] ${PKG}/${path}/apt stable main" | sudo tee /etc/apt/sources.list.d/${id}.list`];
    const deb = val('panel_os') === 'deb';
    const cgiReload = '# restart your FastCGI process manager';

    let steps = '';
    if (os === 'debian') {
      const xenial = checked('xenial');
      const fpmReload = `sudo systemctl reload php${minor}-fpm`;
      const reload = sapi === 'apache' ? 'sudo systemctl reload apache2'
                    : sapi === 'cgi' ? '# restart your FastCGI process manager'
                    : fpmReload;
      if (xenial) {
        steps += step('Prerequisites for Ubuntu 16.04', 'apt 1.2 cannot fetch HTTPS without these.',
          ['sudo apt-get update', 'sudo apt-get install -y apt-transport-https ca-certificates curl']);
        steps += step('Add the repository (xenial key method)', '',
          ['curl -fsSL https://howdah.org/key.asc | sudo apt-key add -',
           `echo "deb ${PKG}/apt stable main" | sudo tee /etc/apt/sources.list.d/howdah.list`]);
      } else {
        steps += step('Add the signed apt repository', 'The key is pinned to this repository only.',
          ['sudo install -d -m 0755 /etc/apt/keyrings',
           'curl -fsSL https://howdah.org/key.asc | sudo tee /etc/apt/keyrings/howdah.asc >/dev/null',
           `echo "deb [signed-by=/etc/apt/keyrings/howdah.asc] ${PKG}/apt stable main" | sudo tee /etc/apt/sources.list.d/howdah.list`]);
      }
      steps += step('Install the package for your PHP', `Installs only against a matching PHP ABI, and enables the module for PHP ${minor}.`,
        ['sudo apt-get update', `sudo apt-get install php${minor}-howdah`]);
      steps += step('Verify it is loaded, then reload your server', '',
        ['php -m | grep -i howdah', 'php --ri howdah          # Howdah => enabled, Mode => detect', reload]);
      steps += step('Roll back at any time', '',
        [`sudo phpdismod -v ${minor} howdah        # stop loading, keep the package`,
         `sudo apt-get purge php${minor}-howdah    # or remove everything`, reload]);
    } else if (os === 'rhel') {
      const reload = sapi === 'apache' ? 'sudo systemctl reload httpd'
                    : sapi === 'cgi' ? '# restart your FastCGI process manager'
                    : `sudo systemctl reload php${xy}-php-fpm`;
      steps += step('Import the key and add the yum repository', 'Both package and metadata signatures are enforced.',
        ['sudo rpm --import https://howdah.org/key.asc',
         'sudo tee /etc/yum.repos.d/howdah.repo >/dev/null <<\'REPO\'',
         '[howdah]', 'name=Howdah (defensive WAF for PHP)', `baseurl=${PKG}/yum`,
         'enabled=1', 'gpgcheck=1', 'repo_gpgcheck=1', 'gpgkey=https://howdah.org/key.asc', 'REPO']);
      steps += step('Install the package (Remi layout)', `Requires php${xy}-php-common from Remi. Use dnf on 8/9.`,
        [`sudo yum install php${xy}-howdah`]);
      steps += step('Verify it is loaded, then reload your server', '',
        [`/opt/remi/php${xy}/root/usr/bin/php -m | grep -i howdah`,
         `/opt/remi/php${xy}/root/usr/bin/php --ri howdah`, reload]);
      steps += step('Roll back at any time', 'A locally edited ini is kept as 40-howdah.ini.rpmsave.',
        [`sudo yum remove php${xy}-howdah`, reload]);
    } else if (os === 'el') {
      const reload = sapi === 'apache' ? 'sudo systemctl reload httpd'
                    : sapi === 'cgi' ? cgiReload : 'sudo systemctl reload php-fpm';
      steps += step(`Import the key and add the repository for PHP ${minor}`,
        `One repository per PHP minor: the distribution's package names carry no version. Both package and metadata signatures are enforced.`,
        yumRepo('howdah-el', `Howdah for the distribution PHP ${minor}`, `el/php${minor}`));
      steps += step('Install the package', `Installs only against PHP ${minor}'s exact ABI (<code>php(zend-abi)</code>).`,
        ['sudo dnf install php-howdah      # yum on CentOS 7']);
      steps += step('Verify it is loaded, then reload your server', '',
        ['php -m | grep -i howdah', 'php --ri howdah          # Howdah => enabled, Mode => detect', reload]);
      steps += step('Roll back, or change PHP minor', 'Before switching PHP minor, remove the package, point <code>baseurl</code> at the new minor, then install again.',
        ['sudo dnf remove php-howdah', reload]);
    } else if (os === 'cpanel') {
      const reload = sapi === 'apache' ? 'sudo /scripts/restartsrv_httpd'
                    : sapi === 'cgi' ? cgiReload : 'sudo /scripts/restartsrv_apache_php_fpm';
      const pkg = `ea-php${xy}-php-howdah`;
      steps += step('Import the key and add the cPanel repository', 'Both package and metadata signatures are enforced.',
        deb ? aptRepo('howdah-cpanel', 'cpanel') : yumRepo('howdah-cpanel', 'Howdah for cPanel EasyApache 4', 'cpanel'));
      steps += step(`Install with ${deb ? 'apt' : 'dnf or yum'}, not the EasyApache 4 screen`,
        `The EasyApache 4 interface only installs cPanel's own PHP packages. Requires <code>ea-php${xy}-php-common</code>.`,
        deb ? ['sudo apt-get update', `sudo apt-get install ${pkg}`] : [`sudo dnf install ${pkg}     # yum on CentOS 7`]);
      steps += step('Verify it is loaded, then restart PHP', '',
        [`/opt/cpanel/ea-php${xy}/root/usr/bin/php -m | grep -i howdah`,
         `/opt/cpanel/ea-php${xy}/root/usr/bin/php --ri howdah`, reload]);
      steps += step('After provisioning an EasyApache 4 profile', 'Provisioning installs the profile\'s packages and uninstalls the rest, and this package is not in cPanel\'s EA4 repository. Check it is still there, and install it again if not. Updating the ea-php packages with the package manager leaves it in place.',
        [deb ? `dpkg -s ${pkg} | grep Status` : `rpm -q ${pkg}`]);
      steps += step('Roll back at any time', '',
        [deb ? `sudo apt-get purge ${pkg}` : `sudo dnf remove ${pkg}`, reload]);
    } else if (os === 'plesk') {
      const reload = sapi === 'cgi' ? cgiReload : `sudo systemctl restart plesk-php${xy}-fpm`;
      const pkg = `plesk-php${xy}-howdah`;
      steps += step('Import the key and add the Plesk repository', 'Both package and metadata signatures are enforced.',
        deb ? aptRepo('howdah-plesk', 'plesk') : yumRepo('howdah-plesk', 'Howdah for Plesk PHP', 'plesk'));
      steps += step('Install the package for your Plesk PHP', `Requires <code>plesk-php${xy}</code>.`,
        deb ? ['sudo apt-get update', `sudo apt-get install ${pkg}`] : [`sudo dnf install ${pkg}`]);
      steps += step('Verify it is loaded, then restart PHP', '<code>php_handler --reread</code> makes Plesk\'s PHP settings page list the module.',
        [`/opt/plesk/php/${minor}/bin/php -m | grep -i howdah`, 'sudo plesk bin php_handler --reread', reload]);
      steps += step('Roll back at any time', '',
        [deb ? `sudo apt-get purge ${pkg}` : `sudo dnf remove ${pkg}`, reload]);
    } else if (os === 'cloudlinux') {
      const pkg = `alt-php${xy}-howdah`;
      steps += step('Import the key and add the CloudLinux repository', 'Both package and metadata signatures are enforced.',
        yumRepo('howdah-cloudlinux', 'Howdah for CloudLinux alt-php', 'cloudlinux'));
      steps += step('Install, then enable it in the PHP Selector', `The module goes into alt-php ${minor}'s PHP Selector list; it loads for the users it is enabled for. Not install-tested: alt-php needs a CloudLinux licence.`,
        [`sudo yum install ${pkg}`, 'sudo cagefsctl --setup-cl-selector',
         `sudo selectorctl --version=${minor} --enable-extensions=howdah   # all users on alt-php ${minor}; or per user in the PHP Selector`]);
      steps += step('Verify from a site that uses it', 'Sends two harmless requests and reports whether Howdah answered.',
        ['curl -fsSLO https://github.com/howdah/howdah/releases/latest/download/howdah-check',
         'sh howdah-check web https://your.site/']);
      steps += step('Roll back at any time', '',
        [`sudo selectorctl --version=${minor} --disable-extensions=howdah`, `sudo yum remove ${pkg}`]);
    } else if (os === 'docker') {
      const img = `ghcr.io/howdah/howdah:${VERSION}-php${minor}`;
      const base = sapi === 'apache' ? `php:${minor}-apache` : `php:${minor}-fpm`;
      if (minor === '5.4' || minor === '5.5') {
        steps += step(`No image for PHP ${minor}`,
          `Current Docker cannot pull the official <code>php:${minor}</code> images (5.4 is an old manifest format, 5.5 has a missing layer), so there is no Howdah image for ${minor}. Copy the tarball's <code>howdah.so</code> and <code>howdah.ini</code> into your own image instead (<b>DirectAdmin / other</b> above has the download and verify steps).`,
          ['./howdah-check detect      # inside your container: the tarball for its API']);
      } else {
        if (sapi !== 'apache') {
          steps += step('Start from the Howdah image', `The official <code>php:${minor}-fpm</code> image with Howdah installed and enabled in detect mode, for amd64 and arm64.`,
            [`FROM ${img}`, 'COPY . /var/www/html']);
        }
        steps += step(sapi === 'apache' ? 'Add Howdah to your image' : 'Or add Howdah to your own image',
          `One line copies the extension, its ini and <code>howdah-check</code> onto any official PHP ${minor} image (fpm, apache or cli). Not onto a <code>-zts</code> image.` + (parseFloat(minor) >= 7.2 ? ` On an <code>-alpine</code> base use the <code>${VERSION}-php${minor}-alpine</code> tag.` : ` (No <code>-alpine</code> image for PHP ${minor} — the musl build needs PHP 7.2+; use the Debian image.)`),
          [`FROM ${base}`, `COPY --from=${img} /howdah/ /`]);
        steps += step('Verify it is loaded, then check it over HTTP', 'The web check sends two harmless requests to your site.',
          [`docker run --rm ${img} php --ri howdah     # Howdah => enabled, Mode => detect`,
           `docker run --rm --network <your network> ${img} howdah-check web http://<your web container>/`]);
        steps += step('Roll back', 'Remove the <code>COPY --from</code> line, or go back to the plain image, and rebuild.', [`FROM ${base}`]);
      }
    } else {
      // tarball / manual
      const reload = sapi === 'apache' ? 'sudo systemctl reload apache2   # or httpd'
                    : sapi === 'cgi' ? '# restart your FastCGI process manager'
                    : `sudo systemctl reload php${minor}-fpm`;
      steps += step('Find your PHP builds (changes nothing)', 'howdah-check lists every PHP install and the exact tarball to download.',
        ['curl -fsSLO https://github.com/howdah/howdah/releases/latest/download/howdah-check',
         'chmod +x howdah-check', './howdah-check detect',
         '# -> PHP ' + minor + '.x, API <nnnnnnnn>, NTS, <extension_dir>, SAPIs: ...']);
      steps += step('Download, verify the signature, then install', 'Match the tarball to your PHP minor and Zend API number (the API line above).',
        ['B=https://github.com/howdah/howdah/releases/latest/download',
         `T=howdah-${VERSION}-php${minor}-<api>-linux-$(uname -m).tar.gz`,
         'curl -fLO $B/$T -O $B/SHA256SUMS -O $B/SHA256SUMS.asc -O $B/howdah-release-signing.asc',
         'sha256sum -c --ignore-missing SHA256SUMS',
         'gpg --import howdah-release-signing.asc',
         'gpg --verify SHA256SUMS.asc SHA256SUMS',
         'tar xzf $T',
         `sudo cp howdah-${VERSION}-php${minor}/howdah.so  "$(php-config --extension-dir)/"`,
         `sudo cp howdah-${VERSION}-php${minor}/howdah.ini <your PHP conf.d dir, e.g. /etc/php/${minor}/mods-available/>`,
         `# DirectAdmin: php-config is /usr/local/php${xy}/bin/php-config; the ini goes to /usr/local/php${xy}/lib/php.conf.d/90-howdah.ini`]);
      steps += step('Enable and verify', 'Howdah ships in detect mode; the critical limits still block.',
        ['php --ri howdah', 'howdah-check web https://your.site/', reload]);
      steps += step('Roll back', 'Remove the ini line (or the conf.d file) and reload.', [reload]);
    }

    result.innerHTML = steps;
    // keep the os-step legend numbers sensible (debian, cPanel and Plesk have an extra step)
    const osHasSource = ['debian', 'cpanel', 'plesk'].includes(os);
    document.querySelectorAll('[data-os-step]').forEach((e) => e.textContent = osHasSource ? '3' : '2');
    document.querySelectorAll('[data-os-step2]').forEach((e) => e.textContent = osHasSource ? '4' : '3');
  }

  form.addEventListener('change', render);
  render();
</script>

<style>
