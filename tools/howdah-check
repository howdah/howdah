#!/bin/sh
# howdah-check - read-only helper for installing/verifying Howdah.
#
#   howdah-check detect     list every PHP install on this box, the host arch
#                           and libc, and the release tarball that matches each install
#   howdah-check web <url>  EICAR-style self-test over HTTP (see cmd_web)
#   howdah-check ini [php]  read-only report of risky php.ini settings (see cmd_ini)
#
# For each install, detect prints: version, PHP API number, NTS/ZTS,
# extension_dir, ini scan dir, the exact release asset to download for it (host
# CPU arch + libc + api + PHP MAJ.MIN: howdah-<VERSION>-php<minor>-<api>-linux-<arch>.tar.gz,
# or ...-linux-x86_64-musl.tar.gz on musl/Alpine),
# the packaging layout (sury, remi, cpanel, plesk, cloudlinux, directadmin,
# stock-rhel, stock-debian, docker, alpine, litespeed, unknown) and the package + repo
# (or Docker image) Howdah ships for
# it (or the tarball), the SAPIs present (cli/fpm/apache) and whether the `howdah`
# extension is loaded in each. It NEVER modifies anything: it only runs
# `php -v/-i/-m`, `php-fpm -m`, `php-config`, musl's loader with no arguments
# (which prints the musl version), and reads config files.
#
# POSIX sh only (dash/ash/old bash; CentOS 7, Ubuntu 16.04, busybox). Every
# probe degrades gracefully: a missing/failed probe prints "unknown" for that
# field and never aborts the run.
#
# Env: HOWDAH_CHECK_ROOT      prefix prepended to the fixed discovery paths (tests).
#      HOWDAH_CHECK_UNAME_M   stand-in for `uname -m` output (tests).

PROG=howdah-check
ROOT=${HOWDAH_CHECK_ROOT:-}
NL='
'

say() { printf '%s\n' "$*"; }

usage() {
  say "usage: $PROG detect | web <url> | ini [php-binary]" >&2
  say "  ini      report risky php.ini settings (register_argc_argv, allow_url_include, ...); changes nothing" >&2
  say "  detect   find every PHP install; report host arch + the matching release asset (read-only)" >&2
  say "  web URL  send two harmless self-test requests; confirms Howdah is live in the web SAPI" >&2
}

# --- small helpers ----------------------------------------------------------

# normalize a `uname -m` value: arm64 -> aarch64; x86_64/aarch64 pass through;
# anything else is reported verbatim
norm_arch() {
  case "$1" in
    arm64) echo aarch64 ;;
    '') echo unknown ;;
    *) printf '%s\n' "$1" ;;
  esac
}
# a PHP .so must match the host CPU, so arch is host-wide: computed once
ARCH=$(norm_arch "${HOWDAH_CHECK_UNAME_M:-$(uname -m 2>/dev/null)}")
# ... and the host C library: a glibc .so does not load on musl (Alpine), which
# has its own -musl tarball (x86_64 only). musl is recognised by its loader.
LIBC=glibc
MUSL_LD=""
for _l in "$ROOT"/lib/ld-musl-*.so.1; do [ -e "$_l" ] && { LIBC=musl; MUSL_LD=$_l; }; done
SUFFIX="linux-$ARCH"
[ "$LIBC" = musl ] && SUFFIX="linux-$ARCH-musl"
# official runtime images (docker/Dockerfile, docs/install-docker.md)
IMAGE_REPO=ghcr.io/howdah/howdah

# run a command with a timeout when one is available (never hang the run)
HAVE_TMO=0
if command -v timeout >/dev/null 2>&1 && timeout 1 true >/dev/null 2>&1; then HAVE_TMO=1; fi
tmo() {
  if [ "$HAVE_TMO" = 1 ]; then
    timeout 15 "$@"
  else
    "$@"
  fi
}

# $1 < $2 for dotted numeric versions (1.1.22 < 1.1.24 < 1.2.5)
ver_lt() {
  awk -v a="$1" -v b="$2" 'BEGIN { n = split(a, x, "."); m = split(b, y, "."); k = (n > m ? n : m)
    for (i = 1; i <= k; i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 } exit 1 }'
}
# musl's loader prints its version when run with no arguments. Howdah's musl
# build needs musl 1.1.24 or newer (Alpine 3.11+; packaging/musl-floor-check.sh):
# on an older musl PHP refuses the module ("Error relocating ...: symbol not found").
MUSL_FLOOR=1.1.24
LIBC_VER=""
MUSL_OLD=0
if [ "$LIBC" = musl ] && [ -x "$MUSL_LD" ]; then
  LIBC_VER=$(tmo "$MUSL_LD" </dev/null 2>&1 | sed -n 's/^Version \([0-9][0-9.]*\).*/\1/p' | head -n 1)
fi
if [ -n "$LIBC_VER" ] && ver_lt "$LIBC_VER" "$MUSL_FLOOR"; then MUSL_OLD=1; fi
MUSL_OLD_MSG="Howdah's musl build needs musl $MUSL_FLOOR or newer (Alpine 3.11+); this is musl $LIBC_VER"

realp() {
  _r=$(readlink -f "$1" 2>/dev/null)
  if [ -n "$_r" ]; then printf '%s\n' "$_r"; else printf '%s\n' "$1"; fi
}

# "7.4.33-1+ubuntu" -> 7.4
mm_of() { printf '%s\n' "$1" | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p'; }

# is there an *active* extension=howdah line in any of the given files?
ini_has_howdah() {
  for _f in "$@"; do
    [ -f "$_f" ] || continue
    if grep -Eq '^[[:space:]]*(zend_)?extension[[:space:]]*=[[:space:]]*["'"'"']?([^"'"'"';]*/)?howdah(\.so)?["'"'"']?[[:space:]]*(;.*)?$' "$_f" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

# scan a SAPI config dir (php.ini + conf.d/*.ini + php.d/*.ini): loaded|not-loaded|unknown
scan_dir_state() {
  _d=$1
  [ -d "$_d" ] || { echo unknown; return; }
  if ini_has_howdah "$_d"/php.ini "$_d"/conf.d/*.ini "$_d"/php.d/*.ini ${2:+"$2"}; then
    echo loaded
  else
    echo not-loaded
  fi
}

# --- candidate discovery ----------------------------------------------------

CANDS=""     # newline-separated php binaries
CONFIGS=""   # newline-separated php-config binaries

is_php_name() {
  case "$1" in
    *config*|*fpm*|*cgi*|*dbg*|*ize*) return 1 ;;
    php|php[0-9]*|php-[0-9]*) return 0 ;;
  esac
  return 1
}

add_cand() {
  [ -f "$1" ] && [ -x "$1" ] || return 0
  is_php_name "$(basename "$1")" || return 0
  CANDS="$CANDS$1$NL"
}

add_config() {
  [ -f "$1" ] && [ -x "$1" ] || return 0
  case "$(basename "$1")" in php-config*) CONFIGS="$CONFIGS$1$NL" ;; esac
}

discover() {
  # 1. PATH
  _oifs=$IFS; IFS=:
  for _d in $PATH; do
    IFS=$_oifs
    if [ -n "$_d" ]; then
      for _f in "$_d"/php "$_d"/php[0-9]* "$_d"/php-[0-9]*; do add_cand "$_f"; done
      for _f in "$_d"/php-config*; do add_config "$_f"; done
    fi
    IFS=:
  done
  IFS=$_oifs

  # 2. well-known fixed layouts (distro, Remi, cPanel EA, CloudLinux alt, Plesk, /opt)
  for _f in \
    "$ROOT"/usr/bin/php "$ROOT"/usr/bin/php[0-9]* "$ROOT"/usr/local/bin/php "$ROOT"/usr/local/bin/php[0-9]* \
    "$ROOT"/usr/local/php*/bin/php "$ROOT"/opt/php*/bin/php "$ROOT"/opt/php*/usr/bin/php \
    "$ROOT"/opt/remi/php*/root/usr/bin/php "$ROOT"/opt/cpanel/ea-php*/root/usr/bin/php \
    "$ROOT"/opt/alt/php*/usr/bin/php "$ROOT"/opt/plesk/php/*/bin/php \
    "$ROOT"/usr/local/lsws/lsphp*/bin/php
  do add_cand "$_f"; done
  for _f in \
    "$ROOT"/usr/bin/php-config* "$ROOT"/usr/local/bin/php-config* "$ROOT"/opt/php*/bin/php-config* \
    "$ROOT"/opt/remi/php*/root/usr/bin/php-config "$ROOT"/opt/cpanel/ea-php*/root/usr/bin/php-config \
    "$ROOT"/opt/alt/php*/usr/bin/php-config "$ROOT"/opt/plesk/php/*/bin/php-config
  do add_config "$_f"; done

  # 3. whatever php-config says the binary is
  _oifs=$IFS; IFS=$NL
  for _c in $CONFIGS; do
    IFS=$_oifs
    _b=$(tmo "$_c" --php-binary 2>/dev/null | head -1)
    [ -n "$_b" ] && add_cand "$_b"
    IFS=$NL
  done
  IFS=$_oifs
}

# --- per-install probing ----------------------------------------------------

SEEN_REAL=""
SEEN_MM=""
FOUND=0

# $1=php binary $2=MAJ.MIN -> prints the matching php-fpm path, or nothing
find_fpm() {
  _bd=$(dirname "$1")
  _fm=$2
  [ -n "$_fm" ] || return 0
  for _p in "$ROOT/usr/sbin/php-fpm$_fm" "$_bd/php-fpm" "$_bd/../sbin/php-fpm" "$_bd/../../sbin/php-fpm" \
            "$ROOT/usr/sbin/php-fpm"; do
    [ -f "$_p" ] && [ -x "$_p" ] || continue
    # a version-named php-fpm is trusted; EVERY unversioned one must report the same MAJ.MIN
    case "$_p" in
      */php-fpm"$_fm") ;;
      *)
        _fv=$(tmo "$_p" -v 2>/dev/null | sed -n '/^PHP [0-9]/{s/^PHP \([0-9][0-9.]*\).*/\1/p;q;}')
        [ "$(mm_of "$_fv")" = "$_fm" ] || continue ;;
    esac
    printf '%s\n' "$_p"
    return 0
  done
}

# $1=MAJ.MIN $2=MMnodot $3=php binary -> prints a mod_php path, or nothing
find_apache() {
  [ -n "$1" ] || return 0
  # version-named modules in the shared system dirs (never a bare libphp*.so glob there)
  for _p in \
    "$ROOT/usr/lib/apache2/modules/libphp$1.so" "$ROOT/usr/lib64/httpd/modules/libphp$1.so" \
    "$ROOT/usr/lib/httpd/modules/libphp$1.so" "$ROOT/usr/lib64/apache2/modules/libphp$1.so" \
    "$ROOT/opt/cpanel/ea-php$2/root/usr/lib64/httpd/modules/libphp"*.so
  do
    [ -f "$_p" ] && { printf '%s\n' "$_p"; return 0; }
  done
  # a private prefix (/opt/phpNN/...) owns any libphp*.so under it; /usr and /usr/local do not
  _pre=$(realp "$(dirname "$3")/..")
  case "$_pre" in
    /|/usr|/usr/local|"$ROOT"|"$ROOT/usr"|"$ROOT/usr/local") return 0 ;;
  esac
  for _p in "$_pre"/lib64/httpd/modules/libphp*.so "$_pre"/lib/httpd/modules/libphp*.so \
            "$_pre"/lib/apache2/modules/libphp*.so "$_pre"/usr/lib64/httpd/modules/libphp*.so; do
    [ -f "$_p" ] && { printf '%s\n' "$_p"; return 0; }
  done
}

report_install() {
  _bin=$1
  _real=$(realp "$_bin")
  case "$SEEN_REAL" in *"$NL$_real$NL"*|"$_real$NL"*) return 0 ;; esac

  # find the banner anywhere in the output (startup warnings may precede it)
  _vline=$(tmo "$_bin" -v 2>/dev/null | sed -n '/^PHP [0-9]/{p;q;}')
  _info=$(tmo "$_bin" -i 2>/dev/null)
  if [ -z "$_vline" ]; then
    # No banner: still an install if it demonstrably runs as PHP. Never omit one silently.
    case "$_info" in
      *"PHP Version =>"*) ;;
      *) tmo "$_bin" -m 2>/dev/null | grep -q '^\[PHP Modules\]' || return 0 ;;
    esac
  fi
  SEEN_REAL="$SEEN_REAL$_real$NL"
  FOUND=$((FOUND + 1))

  _ver=$(printf '%s\n' "$_info" | sed -n 's/^PHP Version => \(.*[^ ]\) *$/\1/p' | head -1)
  [ -n "$_ver" ] || _ver=$(printf '%s\n' "$_vline" | sed -n 's/^PHP \([^ ]*\).*/\1/p')
  _api=$(printf '%s\n' "$_info" | sed -n 's/^PHP API => \([0-9][0-9]*\).*/\1/p' | head -1)
  _ts=$(printf '%s\n' "$_info" | sed -n 's/^Thread Safety => \([a-z]*\).*/\1/p' | head -1)
  _ext=$(printf '%s\n' "$_info" | sed -n 's/^extension_dir => \([^ ][^=]*[^ =]\) *=>.*/\1/p' | head -1)
  [ -n "$_ext" ] || _ext=$(printf '%s\n' "$_info" | sed -n 's/^extension_dir => \([^ ][^=]*[^ =]\) *$/\1/p' | head -1)
  _ini=$(printf '%s\n' "$_info" | sed -n 's/^Loaded Configuration File => \(.*[^ ]\) *$/\1/p' | head -1)
  _scan=$(printf '%s\n' "$_info" | sed -n 's/^Scan this dir for additional \.ini files => \(.*[^ ]\) *$/\1/p' | head -1)

  _mm=$(mm_of "$_ver")
  _mmn=$(printf '%s' "$_mm" | tr -d .)

  # fallback 1: the sibling php-config
  _pc=""
  for _c in "$(dirname "$_bin")/php-config" "$(dirname "$_bin")/php-config$_mm"; do
    [ -x "$_c" ] && { _pc=$_c; break; }
  done
  if [ -n "$_pc" ]; then
    [ -n "$_ext" ] || _ext=$(tmo "$_pc" --extension-dir 2>/dev/null | head -1)
  fi
  # fallback 2: the extension_dir suffix, e.g. .../no-debug-non-zts-20190902 or .../20190902
  if [ -z "$_api" ] && [ -n "$_ext" ]; then
    _api=$(printf '%s\n' "$_ext" | sed -n 's/.*[^0-9]\([0-9]\{8\}\)[^0-9]*$/\1/p')
  fi
  if [ -z "$_ts" ]; then
    case "$_ext" in
      *non-zts*) _ts=disabled ;;
      *zts*) _ts=enabled ;;
    esac
  fi
  case "$_ts" in
    disabled) _tsl=NTS ;;
    enabled) _tsl=ZTS ;;
    *) _tsl=unknown ;;
  esac

  say "php: $_bin"
  [ "$_real" = "$_bin" ] || say "  realpath: $_real"
  say "  version: ${_ver:-unknown}"
  say "  api: ${_api:-unknown}"
  say "  thread_safety: $_tsl"
  if [ "$LIBC" = musl ] && [ "$ARCH" != x86_64 ]; then
    say "  matching release asset: none: musl builds are x86_64 only"
  elif [ "$MUSL_OLD" = 1 ]; then
    say "  matching release asset: none: $MUSL_OLD_MSG"
  elif [ -n "$_api" ] && [ -n "$_mm" ] && [ "$ARCH" != unknown ]; then
    say "  matching release asset: howdah-<VERSION>-php$_mm-$_api-$SUFFIX.tar.gz"
  else
    say "  matching release asset: cannot determine (api/version/arch unknown)"
  fi
  say "  extension_dir: ${_ext:-unknown}"
  say "  php_ini: ${_ini:-(none)}"
  say "  ini_scan_dir: ${_scan:-(none)}"
  report_layout "$_real" "$_ext" "$_scan" "$_ver" "$_mm" "$_api" "$_tsl"

  # --- cli: ask PHP itself
  if tmo "$_bin" -m 2>/dev/null | grep -qix howdah; then _cs=loaded
  elif tmo "$_bin" -m >/dev/null 2>&1; then _cs=not-loaded
  else _cs=unknown; fi
  say "  sapi cli: present  howdah=$_cs"

  # --- fpm: ask php-fpm -m, else scan its config dir
  _fpm=$(find_fpm "$_bin" "$_mm")
  # Debian /etc/php/<ver>/* belongs only to the distro binary /usr/bin/php<ver>,
  # not to a custom build that merely shares MAJ.MIN.
  _debdir=""
  if [ -n "$_mm" ] && [ "$_real" = "$(realp "$ROOT/usr/bin/php$_mm")" ] && [ -d "$ROOT/etc/php/$_mm" ]; then
    _debdir="$ROOT/etc/php/$_mm"
    SEEN_MM="$SEEN_MM $_mm "   # only the distro binary accounts for /etc/php/<ver>
  fi
  _fdir=""
  if [ -n "$_mmn" ]; then
    for _d in ${_debdir:+"$_debdir/fpm"} "$ROOT/etc/opt/remi/php$_mmn" "$ROOT/opt/cpanel/ea-php$_mmn/root/etc" \
              "$ROOT/opt/alt/php$_mmn/etc"; do
      [ -d "$_d" ] && { _fdir=$_d; break; }
    done
  fi
  if [ -n "$_fpm" ]; then
    if tmo "$_fpm" -m 2>/dev/null | grep -qix howdah; then _fs=loaded
    elif tmo "$_fpm" -m >/dev/null 2>&1; then _fs=not-loaded
    elif [ -n "$_fdir" ]; then _fs=$(scan_dir_state "$_fdir")
    else _fs=unknown; fi
    say "  sapi fpm: present ($_fpm)  howdah=$_fs"
  elif [ -n "$_debdir" ] && [ -d "$_debdir/fpm" ]; then
    say "  sapi fpm: present (config only: $_debdir/fpm)  howdah=$(scan_dir_state "$_debdir/fpm")"
  else
    say "  sapi fpm: absent"
  fi

  # --- apache (mod_php): not runnable, so config files are scanned
  _ap=$(find_apache "$_mm" "$_mmn" "$_bin")
  if [ -n "$_debdir" ] && [ -d "$_debdir/apache2" ]; then
    # Debian: scan apache2's own php.ini + conf.d (contents, not mere directory existence)
    say "  sapi apache: present ($_debdir/apache2)  howdah=$(scan_dir_state "$_debdir/apache2")"
  elif [ -n "$_ap" ]; then
    # non-Debian: assume mod_php reads the CLI's main php.ini + scan dir; unknown if neither is known
    _as=unknown
    _sd=""
    if [ -n "$_scan" ] && [ "$_scan" != "(none)" ]; then _sd=$_scan; fi
    if [ -n "$_sd" ] || { [ -n "$_ini" ] && [ "$_ini" != "(none)" ]; }; then
      if ini_has_howdah ${_ini:+"$_ini"} ${_sd:+"$_sd"/*.ini}; then _as=loaded; else _as=not-loaded; fi
    fi
    say "  sapi apache: present ($_ap)  howdah=$_as"
  else
    say "  sapi apache: absent"
  fi
}

# Debian-style /etc/php/<ver> dirs whose version had no runnable binary
report_config_only() {
  for _d in "$ROOT"/etc/php/[0-9]*; do
    [ -d "$_d" ] || continue
    _v=$(basename "$_d")
    case "$SEEN_MM" in *" $_v "*) continue ;; esac
    FOUND=$((FOUND + 1))
    say "php: (no runnable binary found)"
    say "  version: $_v (from $_d)"
    say "  api: unknown"
    say "  thread_safety: unknown"
    say "  matching release asset: cannot determine (api/version unknown)"
    say "  extension_dir: unknown"
    say "  layout: unknown (config only)"
    say "  howdah package: cannot determine (no runnable PHP binary)"
    for _s in cli fpm apache2; do
      _n=$_s; [ "$_s" = apache2 ] && _n=apache
      if [ -d "$_d/$_s" ]; then
        say "  sapi $_n: present (config only)  howdah=$(scan_dir_state "$_d/$_s")"
      else
        say "  sapi $_n: absent"
      fi
    done
  done
}

# --- layout: which packaging layout an install follows, and what Howdah ships --
# The layout is read from extension_dir first (cPanel's /usr/local/bin/php
# wrapper reports the ea-php paths), then from the binary path. The names and
# package patterns mirror packaging/layouts.tsv (tools/howdah-check.test.sh
# fails if they drift) plus the original two repos: Surý/Debian apt and Remi
# SCL yum. Vendor sources for every path: docs/packaging-layouts.md.
PKG_URL=https://pkg.howdah.org

# $1=binary realpath $2=extension_dir $3=ini scan dir $4=version -> layout name
php_layout() {
  _lv=$4
  case "$2" in
    */opt/cpanel/ea-php[0-9]*/root/usr/lib64/php/modules) echo cpanel; return 0 ;;
    */opt/plesk/php/[0-9]*/lib64/php/modules|*/opt/plesk/php/[0-9]*/lib/php/modules) echo plesk; return 0 ;;
    */opt/alt/php[0-9]*/usr/lib64/php/modules) echo cloudlinux; return 0 ;;
    */opt/remi/php[0-9]*/root/usr/lib64/php/modules) echo remi; return 0 ;;
    */usr/lib/php/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
      # Debian layout; Surý builds say so in their version string
      case "$_lv" in *sury*) echo sury ;; *) echo stock-debian ;; esac
      return 0 ;;
    */usr/lib64/php/modules|*/usr/lib64/php[0-9]*/modules)
      # RHEL/Alma/Rocky/Amazon Linux distribution PHP reads /etc/php.d
      case "$3" in */etc/php.d) echo stock-rhel; return 0 ;; esac ;;
    */usr/local/php[0-9]*/lib/php/extensions/*)
      # DirectAdmin CustomBuild: /usr/local/phpXY with lib/php.conf.d drop-ins
      case "$3" in */usr/local/php[0-9]*/lib/php.conf.d) echo directadmin; return 0 ;; esac ;;
    */usr/local/lsws/lsphp[0-9]*/lib/php/[0-9]*|*/usr/local/lsws/lsphp[0-9]*/lib64/php/modules)
      # LiteSpeed's own lsphp packages (deb: lib/php/API, rpm: lib64/php/modules)
      echo litespeed; return 0 ;;
    */usr/lib/php[0-9]*/modules)
      # Alpine's own PHP packages (apk add php83): /etc/php83/conf.d drop-ins
      case "$3" in */etc/php[0-9]*/conf.d) echo alpine; return 0 ;; esac ;;
    */usr/local/lib/php/extensions/no-debug-*)
      # the official Docker php images (Debian and Alpine): PHP_INI_DIR=/usr/local/etc/php
      case "$3" in */usr/local/etc/php/conf.d) echo docker; return 0 ;; esac ;;
    '')
      case "$1" in
        */opt/cpanel/ea-php[0-9]*/root/usr/bin/*) echo cpanel; return 0 ;;
        */opt/plesk/php/[0-9]*/bin/*) echo plesk; return 0 ;;
        */opt/alt/php[0-9]*/usr/bin/*) echo cloudlinux; return 0 ;;
        */opt/remi/php[0-9]*/root/usr/bin/*) echo remi; return 0 ;;
        */usr/local/lsws/lsphp[0-9]*/bin/*) echo litespeed; return 0 ;;
      esac ;;
  esac
  echo unknown
}

# $1=layout $2=MAJ.MIN $3=api $4=NTS|ZTS|unknown -> what Howdah ships for it
howdah_package() {
  _pm=$2; _pa=$3
  _px=$(printf '%s' "$_pm" | tr -d .)
  _tar="howdah-<VERSION>-php$_pm-$_pa-$SUFFIX.tar.gz"
  if [ "$4" = ZTS ]; then echo "none: Howdah is built for NTS PHP only and this PHP is ZTS"; return 0; fi
  if [ -z "$_pa" ] || [ -z "$_pm" ] || [ "$ARCH" = unknown ]; then
    echo "cannot determine (api/version/arch unknown)"; return 0
  fi
  case "$_pm" in
    5.[456]|7.[0-4]|8.[0-5]) ;;
    *) echo "none: Howdah is built for PHP 5.4 to 8.5; this is PHP $_pm"; return 0 ;;
  esac
  if [ "$LIBC" = musl ] && [ "$ARCH" != x86_64 ]; then echo "none: musl builds are x86_64 only"; return 0; fi
  if [ "$1" = docker ]; then
    # images exist where an official php:<minor>-fpm[-alpine] base can be pulled
    case "$_pm" in
      5.[45]) echo "no image for PHP $_pm: use the tarball for API $_pa ($_tar)"; return 0 ;;
    esac
    # -alpine images only where the Alpine base has musl 1.1.24+ (7.2 and later)
    _old=$MUSL_OLD
    case "$_pm" in 5.6|7.0|7.1) [ "$LIBC" = musl ] && _old=1 ;; esac
    if [ "$_old" = 1 ]; then
      echo "no -alpine image for PHP $_pm (its Alpine base has musl older than $MUSL_FLOOR): use the Debian image $IMAGE_REPO:<VERSION>-php$_pm"
      return 0
    fi
    _img="$IMAGE_REPO:<VERSION>-php$_pm"; [ "$LIBC" = musl ] && _img="$_img-alpine"
    echo "image $_img, or in your Dockerfile: COPY --from=$_img /howdah/ /"
    return 0
  fi
  # apt/yum packages are glibc builds
  if [ "$MUSL_OLD" = 1 ]; then echo "none: $MUSL_OLD_MSG"; return 0; fi
  if [ "$LIBC" = musl ]; then echo "not yet packaged for musl: use the tarball for API $_pa ($_tar)"; return 0; fi
  _deb=0; [ -f "$ROOT/etc/debian_version" ] && _deb=1
  _fmt=rpm; _repo=""; _arches="x86_64 aarch64"
  case "$1" in
    sury|stock-debian) _name="php$_pm-howdah"; _fmt=deb ;;
    remi) _name="php$_px-howdah" ;;
    cpanel) _name="ea-php$_px-php-howdah"; _repo=cpanel/; _arches=x86_64
            [ "$_deb" = 1 ] && _fmt=deb ;;
    plesk) _name="plesk-php$_px-howdah"; _repo=plesk/
           if [ "$_deb" = 1 ]; then _fmt=deb; else _arches=x86_64; fi ;;
    cloudlinux) _name="alt-php$_px-howdah"; _repo=cloudlinux/; _arches=x86_64 ;;
    stock-rhel) _name="php-howdah"; _repo="el/php$_pm/" ;;
    *) echo "not yet packaged: use the tarball for API $_pa ($_tar)"; return 0 ;;
  esac
  case " $_arches " in
    *" $ARCH "*) ;;
    *) echo "not yet packaged for $ARCH: use the tarball for API $_pa ($_tar)"; return 0 ;;
  esac
  if [ "$_fmt" = deb ]; then
    echo "$_name (apt repo $PKG_URL/${_repo}apt, suite stable, component main)"
  else
    echo "$_name (yum/dnf repo $PKG_URL/${_repo}yum)"
  fi
}

# $1=realpath $2=extension_dir $3=scan dir $4=version $5=MAJ.MIN $6=api $7=NTS|ZTS|unknown
report_layout() {
  _lay=$(php_layout "$1" "$2" "$3" "$4")
  say "  layout: $_lay"
  say "  howdah package: $(howdah_package "$_lay" "$5" "$6" "$7")"
}

cmd_detect() {
  say "host arch: $ARCH"
  say "host libc: $LIBC${LIBC_VER:+ $LIBC_VER}"
  say "release assets and howdah-check: https://github.com/howdah/howdah/releases (replace <VERSION> with the latest release)"
  discover
  _oifs=$IFS; IFS=$NL
  for _b in $CANDS; do
    IFS=$_oifs
    [ -n "$_b" ] && report_install "$_b"
    IFS=$NL
  done
  IFS=$_oifs
  report_config_only
  if [ "$FOUND" -eq 0 ]; then
    say "no PHP installs found"
  else
    say "found $FOUND PHP install(s)"
  fi
  say "note: layer 2 input inspection (sql_injection, path_traversal, command_injection) is log-only by default; it blocks nothing unless [inspect] mode (or a rule_modes entry) is set to block, and global howdah.mode does not arm it. The exception is cgi_arg_injection (php-cgi argument injection, CVE-2012-1823 / CVE-2024-4577), which is enforced by default (it refuses the request); set [inspect] cgi_arg to detect or off to change that (howdah-check does not read your howdah.config; see docs/config.md)"
  say "note: layer 3 sinks (command_exec, unserialize, include, eval, phar, ssrf) are log-only by default; they block nothing unless [sinks] mode (or a per-sink mode) is set to block, and global howdah.mode does not arm them. unserialize, phar and ssrf are off until opted in, and phar/ssrf are armed only by an explicit per-sink mode. The exception is xxe (XML external entities), which is enforced by default: it removes a dangerous libxml flag (LIBXML_NOENT, DTDLOAD, DTDATTR, DTDVALID) from a parse whose XML string declares an external entity, and never blocks a bare DOCTYPE; set [sinks.xml] mode = \"detect\" or \"off\" to change that (see docs/config.md). Also enforced by default is the include/open wrapper-scheme firewall (include_wrapper, file_open): it refuses include/require and fopen/file_get_contents/readfile of a non-file stream wrapper (php://filter chains, php://input, data:, expect://, remote http(s)/ftp(s)) and of a poisonable local target (/proc/self/environ, the session dir, error_log); set [sinks.include] wrapper = \"detect\"/\"off\" and poison = \"detect\"/\"off\" to change that (see docs/config.md)"
  return 0
}

# --- web self-test -----------------------------------------------------------
# Sends two HARMLESS requests (HTTP only; nothing on this box is touched):
#   1. a multipart body carrying the fixed marker field `__howdah_selftest__`
#      -> Howdah logs a self_test event and adds `X-Howdah-Selftest: <id>`
#      -> reported "flagged"
#   2. a multipart body of HOWDAH_CHECK_PARTS (default 2001, one over Howdah's
#      default max_parts of 2000) EMPTY fields: structure only, no payload
#      -> a critical limit, always blocked (403/413) -> reported "BLOCKED"
# If PHP's max_input_vars / max_file_uploads (or a raised Howdah limit) stops
# parsing before the limit is crossed, result 2 can read "not blocked": raise
# HOWDAH_CHECK_PARTS. HOWDAH_CHECK_INSECURE=1 passes -k to curl (self-signed).
cmd_web() {
  _url=${1:-}
  [ -n "$_url" ] || { usage; exit 2; }
  command -v curl >/dev/null 2>&1 || { say "$PROG: web needs curl" >&2; exit 2; }
  _n=${HOWDAH_CHECK_PARTS:-2001}
  case "$_n" in ''|*[!0-9]*) say "$PROG: HOWDAH_CHECK_PARTS must be a number" >&2; exit 2 ;; esac
  _k=""; [ "${HOWDAH_CHECK_INSECURE:-0}" = 1 ] && _k="-k"
  _t=$(mktemp -d 2>/dev/null) || { say "$PROG: cannot create temp dir" >&2; exit 2; }
  # cmd_web writes only to its own mktemp dir (otherwise read-only); clean up
  # on exit, and exit (not just clean up) on INT/TERM.
  trap 'rm -rf "$_t"' EXIT
  trap 'rm -rf "$_t"; exit 130' INT
  trap 'rm -rf "$_t"; exit 143' TERM
  _rc=0

  # 1. self-test marker
  _b=HowdahSelfTestB0
  printf -- '--%s\r\nContent-Disposition: form-data; name="__howdah_selftest__"\r\n\r\n1\r\n--%s--\r\n' "$_b" "$_b" > "$_t/marker.bin"
  _code=$(curl -s $_k -m 30 -o "$_t/m.body" -D "$_t/m.hdr" -w '%{http_code}' -X POST \
    -H "Content-Type: multipart/form-data; boundary=$_b" --data-binary @"$_t/marker.bin" "$_url" 2>/dev/null) || _code=000
  _id=$(tr -d '\r' < "$_t/m.hdr" 2>/dev/null | sed -n 's/^[Xx]-[Hh]owdah-[Ss]elftest:[[:space:]]*//p' | head -n 1)
  if [ -n "$_id" ]; then
    # The header proves Howdah is live whatever the app answered.
    if [ "$_code" = 200 ]; then
      say "selftest marker:   flagged  (HTTP $_code, request id $_id)"
    else
      say "selftest marker:   flagged  (HTTP $_code, request id $_id) [warning: app did not answer 200; Howdah is live regardless]"
    fi
  elif [ "$_code" = 000 ]; then
    say "selftest marker:   NO RESPONSE from $_url"; _rc=1
  else
    say "selftest marker:   NOT flagged (HTTP $_code): Howdah is not active in this web SAPI (or mode=off)"; _rc=1
  fi

  # 2. just over the part limit: structure only, many empty fields
  _b=HowdahLimitB0
  _i=0
  while [ "$_i" -lt "$_n" ]; do
    printf -- '--%s\r\nContent-Disposition: form-data; name="p%s"\r\n\r\n\r\n' "$_b" "$_i"
    _i=$((_i + 1))
  done > "$_t/over.bin"
  printf -- '--%s--\r\n' "$_b" >> "$_t/over.bin"
  _code=$(curl -s $_k -m 60 -o "$_t/o.body" -w '%{http_code}' -X POST \
    -H "Content-Type: multipart/form-data; boundary=$_b" --data-binary @"$_t/over.bin" "$_url" 2>/dev/null) || _code=000
  _id=$(sed -n 's/^request_id:[[:space:]]*//p' "$_t/o.body" 2>/dev/null | tr -d '\r' | head -n 1)
  case "$_code" in
    403|413)
      if grep -q 'Howdah blocked' "$_t/o.body" 2>/dev/null; then
        say "over-limit parts:  BLOCKED  (HTTP $_code, request id ${_id:-unknown}, $_n parts)"
      else
        say "over-limit parts:  refused (HTTP $_code) but not by Howdah ($_n parts)"; _rc=1
      fi ;;
    000) say "over-limit parts:  NO RESPONSE from $_url"; _rc=1 ;;
    *)   say "over-limit parts:  not blocked (HTTP $_code, $_n parts): Layer-1 limits not enforced here"; _rc=1 ;;
  esac

  if [ "$_rc" -eq 0 ]; then say "Howdah is active in the web SAPI at $_url"; fi
  return "$_rc"
}

# --- ini: read-only report of risky php.ini settings ---------------------------
# `howdah-check ini [php-binary]` reads the settings of ONE php binary (default:
# `php` on PATH) with `php -i` and flags the ones that are known preconditions
# for exploited bug classes, each with the one-line reason and what to set
# instead. It changes nothing. Caveats, also printed in the report:
#   * it asks the CLI binary; php-fpm and Apache often load a different php.ini
#     (Debian: /etc/php/<ver>/fpm/php.ini). Run it with that SAPI's binary or
#     compare the file it names.
#   * the CLI overrides register_argc_argv and display_errors at startup, so for
#     those two the value is read from the ini files (built-in default: On).
#   * the session docroot test is a path-name heuristic; howdah-check does not
#     know your document root. The extension runs the same checks (phpinfo /
#     `php --ri howdah`, "Risky ini settings").

# Local Value of directive $2 in `php -i` output $1 ("no value" -> empty)
ini_local() {
  _r=$(printf '%s\n' "$1" | sed -n "s/^$2 => //p" | sed -n '1p')
  _r=${_r%% => *}
  [ "$_r" = "no value" ] && _r=""
  printf '%s\n' "$_r"
}

# last active assignment of directive $1 in the ini files that follow; empty if none
ini_file_value() {
  _n=$1; shift
  for _f in "$@"; do
    [ -f "$_f" ] && grep -E "^[[:space:]]*$_n[[:space:]]*=" "$_f" 2>/dev/null
  done | sed -n '$p' | sed -e 's/^[^=]*=//' -e 's/[[:space:]]*;.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/'
}

ini_is_on() {
  case $(printf '%s' "$1" | tr 'A-Z' 'a-z') in 1|on|yes|true) return 0 ;; esac
  return 1
}

INI_FLAGS=0
ini_flag() { # setting value why fix
  INI_FLAGS=$((INI_FLAGS + 1))
  say "FLAG  $1 = ${2:-(empty)}"
  say "      why: $3"
  say "      set: $4"
}

cmd_ini() {
  _bin=${1:-php}
  command -v "$_bin" >/dev/null 2>&1 || { say "$PROG: ini: cannot run '$_bin' (pass the php binary path)" >&2; exit 2; }
  _info=$(tmo "$_bin" -i 2>/dev/null)
  case "$_info" in *"PHP Version =>"*) ;; *) say "$PROG: ini: '$_bin -i' gave no phpinfo output" >&2; exit 2 ;; esac
  _cf=$(printf '%s\n' "$_info" | sed -n 's/^Loaded Configuration File => \(.*[^ ]\) *$/\1/p' | head -1)
  _sd=$(printf '%s\n' "$_info" | sed -n 's/^Scan this dir for additional \.ini files => \(.*[^ ]\) *$/\1/p' | head -1)
  [ "$_sd" = "(none)" ] && _sd=""
  _files=""
  if [ -n "$_cf" ] && [ "$_cf" != "(none)" ]; then _files=$_cf; fi
  if [ -n "$_sd" ] && [ -d "$_sd" ]; then
    for _f in "$_sd"/*.ini; do [ -f "$_f" ] && _files="$_files $_f"; done
  fi

  say "php: $_bin ($(printf '%s\n' "$_info" | sed -n 's/^PHP Version => \(.*[^ ]\) *$/\1/p' | head -1))"
  say "php_ini: ${_cf:-(none)}${_sd:+  scan dir: $_sd}"
  say "note: read from the CLI binary; php-fpm / Apache may load a different php.ini. This report changes nothing."
  say ""
  INI_FLAGS=0

  # register_argc_argv: the CLI forces it on, so use the files (built-in default On)
  _v=$(ini_file_value register_argc_argv $_files); [ -n "$_v" ] || _v=1
  if ini_is_on "$_v"; then ini_flag register_argc_argv "$_v" \
    "enabling condition for Craft CMS CVE-2024-56145 and Laravel CVE-2024-52301 (web SAPIs only; the CLI always enables it)" \
    "register_argc_argv = Off"; fi

  _v=$(ini_local "$_info" allow_url_include)
  if ini_is_on "$_v"; then ini_flag allow_url_include "$_v" "remote file inclusion" "allow_url_include = Off"; fi

  _v=$(ini_local "$_info" session.upload_progress.enabled)
  if ini_is_on "$_v"; then ini_flag session.upload_progress.enabled "$_v" \
    "session-file writes attacker-controlled data; used in LFI-to-RCE chains" \
    "session.upload_progress.enabled = Off unless an upload progress bar needs it"; fi

  if [ "$(ini_local "$_info" session.save_handler)" = files ]; then
    _sp=$(ini_local "$_info" session.save_path)
    _dir=${_sp##*;}
    _dflt=0
    if [ -z "$_dir" ]; then _dir=/tmp; _dflt=1; fi
    _why=""
    if [ "$_dflt" = 0 ]; then
      case "/$_dir/" in
        */public_html/*|*/htdocs/*|*/httpdocs/*|*/wwwroot/*|*/www/*|*/html/*|*/public/*)
          _why="session file poisoning: session files under a web docroot can be served or included" ;;
      esac
    fi
    if [ -z "$_why" ] && [ -d "$_dir" ]; then
      _perm=$(ls -ld "$_dir" 2>/dev/null | cut -c8)
      if [ "$_perm" = r ]; then
        _why="session file poisoning: session files are named sess_<id>, so a directory others can list exposes valid session ids"
      fi
    fi
    if [ -n "$_why" ]; then ini_flag session.save_path "${_sp:-(unset, system temp dir)}" "$_why" \
      "session.save_path to a directory outside the docroot that only the PHP user can read (mode 0700)"; fi
  fi

  # display_errors: the CLI forces it on, so use the files (built-in default On)
  _v=$(ini_file_value display_errors $_files); [ -n "$_v" ] || _v=1
  case $(printf '%s' "$_v" | tr 'A-Z' 'a-z') in
    1|on|yes|true|stdout) ini_flag display_errors "$_v" \
      "information disclosure: errors reveal paths, queries and versions to visitors" \
      "display_errors = Off and log_errors = On" ;;
  esac

  _v=$(ini_local "$_info" expose_php)
  if ini_is_on "$_v"; then ini_flag expose_php "$_v" "version disclosure in the X-Powered-By header" "expose_php = Off"; fi

  _v=$(ini_local "$_info" enable_dl)
  if ini_is_on "$_v"; then ini_flag enable_dl "$_v" "historic precondition for loading attacker-supplied extensions (web SAPIs)" "enable_dl = Off"; fi

  _v=$(ini_local "$_info" cgi.fix_pathinfo)
  if ini_is_on "$_v"; then ini_flag cgi.fix_pathinfo "$_v" \
    "historic RCE precondition under CGI/FastCGI with nginx (an upload served as image.jpg/x.php runs as PHP); safe when the web server only passes existing .php files; ignored by mod_php" \
    "cgi.fix_pathinfo = 0 after checking the app does not rely on PATH_INFO"; fi

  _df=$(ini_local "$_info" disable_functions | tr -d ' ')
  _open=""
  for _fn in exec system passthru shell_exec popen proc_open; do
    case ",$_df," in *",$_fn,"*) ;; *) _open="${_open:+$_open, }$_fn" ;; esac
  done
  if [ -n "$_open" ]; then ini_flag disable_functions "${_df:-(empty)}" \
    "command-execution functions stay callable after any code-injection bug" \
    "add $_open to disable_functions if the app does not use them"; fi

  if [ "$INI_FLAGS" -eq 0 ]; then say "none flagged"; fi
  say ""
  _v=$(ini_local "$_info" allow_url_fopen)
  if ini_is_on "$_v"; then say "info  allow_url_fopen = $_v (common and needed by many apps; not flagged as a risk; Off blocks URL wrappers in fopen/file_get_contents, which also limits SSRF)"; fi
  _v=$(ini_local "$_info" open_basedir)
  if [ -z "$_v" ]; then say "info  open_basedir is unset (not a flaw by itself; setting it to the app's directories limits what a file-read or include bug can reach)"; fi
  say "$INI_FLAGS risky setting(s) flagged"
  return 0
}

case "${1:-}" in
  ini) shift; cmd_ini "${1:-}"; exit $? ;;
  detect) cmd_detect ;;
  web) shift; cmd_web "${1:-}"; exit $? ;;
  "") usage; exit 2 ;;
  -h|--help|help) usage ;;
  *) say "$PROG: unknown command '$1'" >&2; usage; exit 2 ;;
esac
